---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import StatStrip from '../components/StatStrip.astro';
import VideoSection from '../components/VideoSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Reveal from '../components/Reveal.astro';
import { departments, type DepartmentId } from '../data/catalog';
import { featuredProducts } from '../data/products';
import { brands } from '../data/brands';
import { galleryPhotos } from '../data/gallery';
import { heroSlides, HERO_DESKTOP_MIN } from '../data/heroSlides';

// The hero draws its posters as CSS backgrounds, which the browser cannot spot
// while it is still fetching stylesheets, so the first poster is asked for
// up front instead. One per screen size, so neither is downloaded needlessly.
const heroPreload = [
  { href: heroSlides[0].src, media: `(max-width: ${HERO_DESKTOP_MIN - 1}px)` },
  { href: heroSlides[0].desktop, media: `(min-width: ${HERO_DESKTOP_MIN}px)` },
];

// Home shows 4 brand logos at a time and rotates through all of them.
const brandData = brands.map((b) => ({ logo: b.logo, name: b.name, dark: !!b.dark }));
import { site } from '../data/site';

const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(site.address.mapQuery)}&output=embed`;

const deptIcon: Record<DepartmentId, string> = { marine: 'boat', fishing: 'fish', diving: 'compass' };
const deptTone: Record<DepartmentId, 'current' | 'brass' | 'deep'> = {
  marine: 'current',
  fishing: 'brass',
  diving: 'deep',
};
// Real department photos. Marine shows a product shot (contain on white);
// Fishing & Diving use authentic client lifestyle photography (cover fill).
const deptImage: Partial<Record<DepartmentId, { src: string; fill?: boolean }>> = {
  marine: { src: '/media/products/minn-kota-endura-36.jpg' },
  fishing: { src: '/media/life/kingfish-lift.jpg', fill: true },
  diving: { src: '/media/diving/fins.jpg' },
};

const whyPoints = [
  {
    icon: 'anchor',
    title: 'Trusted since 1991',
    text: 'Belize’s first marine store, and one of the country’s most trusted names in marine, fishing and diving supplies.',
  },
  {
    icon: 'compass',
    title: 'Knowledgeable product guidance',
    text: 'Tell us about your boat, gear or project and we’ll help you find the right product for Belize’s waters.',
  },
  {
    icon: 'boat',
    title: 'Everything under one roof',
    text: 'Marine, fishing and diving supplies in one store, so you can find what you need in a single stop.',
  },
  {
    icon: 'shield',
    title: 'Safety gear in stock',
    text: 'Life-saving and signalling equipment kept in stock for anglers, divers and boat owners.',
  },
];

// Factual, defensible reasons (replaces invented testimonials).
const reasons = [
  { icon: 'clock', text: 'Established in 1991' },
  { icon: 'boat', text: 'Marine, fishing and diving products under one roof' },
  { icon: 'pin', text: 'Convenient Belize City location' },
  { icon: 'tag', text: 'Broad product selection' },
  { icon: 'whatsapp', text: 'Direct assistance by phone, email and WhatsApp' },
];
---

<BaseLayout preloadImages={heroPreload}>
  <HomeHero />

  <!-- Departments split -->
  <section id="departments" class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Three departments, one dock"
        title="Marine, fishing &amp; diving, <span class='text-gradient'>under one roof</span>"
        lead="Whether you’re rigging a skiff, chasing permit on the flats or gearing up for the reef, everything you need is on the shelves."
      />
      <div class="depts">
        {
          Object.values(departments).map((d, i) => (
            <a href={d.href} class="dept" data-reveal data-reveal-delay={i * 120}>
              <div class="dept__media">
                {
                  deptImage[d.id] ? (
                    <span class:list={['dept__photo', { 'dept__photo--fill': deptImage[d.id]!.fill }]}>
                      <img src={deptImage[d.id]!.src} alt={d.title} loading="lazy" />
                      <span class="dept__photo-label">{d.title}</span>
                    </span>
                  ) : (
                    <Media
                      seed={d.id}
                      icon={deptIcon[d.id]}
                      ratio="16 / 10"
                      tone={deptTone[d.id]}
                      label={d.title}
                    />
                  )
                }
              </div>
              <div class="dept__body">
                <h3>{d.title}</h3>
                <p>{d.tagline}</p>
                <ul role="list" class="dept__cats">
                  {d.categories.slice(0, 4).map((c) => (
                    <li><Icon name="check" size={15} /> {c.name}</li>
                  ))}
                </ul>
                <span class="link-arrow">Explore {d.title} <Icon name="arrow" size={16} /></span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured categories (marine) -->
  <section class="section section-tight" style="background: var(--bg-inset)">
    <div class="container">
      <SectionHeader
        eyebrow="Shop by category"
        title="Popular categories"
        linkHref="/marine-supplies"
        linkLabel="All marine supplies"
      />
      <div class="grid auto-fit" style="--min: 250px">
        {
          departments.marine.categories.map((c, i) => (
            <CategoryCard category={c} href={`/marine-supplies#${c.id}`} delay={i * 70} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured products -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Fresh on the shelves"
        title="Featured gear"
        lead="A snapshot of what’s on the shelves right now. Come in or message us for what you need."
        linkHref="/marine-supplies"
        linkLabel="All marine supplies"
      />
      <div class="grid auto-fit" style="--min: 250px">
        {featuredProducts.slice(0, 6).map((p, i) => <ProductCard product={p} delay={i * 70} />)}
      </div>
    </div>
  </section>

  <!-- Why Duke Marine + stats -->
  <section class="section on-dark why">
    <div class="container">
      <div class="why__top">
        <SectionHeader
          eyebrow="Why Duke Marine"
          title="The shop Belize’s <span class='text-gold'>boaters trust</span>"
          lead="Since 1991, Belize’s boaters, anglers and divers have trusted Duke Marine for quality marine, fishing and diving supplies and honest product advice."
        />
      </div>
      <div class="why__grid">
        {
          whyPoints.map((p, i) => (
            <div class="why__card" data-reveal data-reveal-delay={i * 90}>
              <span class="why__icon"><Icon name={p.icon} size={24} /></span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))
        }
      </div>
      <div class="why__stats">
        <StatStrip />
      </div>
    </div>
  </section>

  <!-- Gallery teaser -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Gallery & Video"
        title="Straight from the <span class='text-gradient'>shop</span>"
        lead="Real gear, real boats, real Belize. A peek at what’s on the shelves and out on the water."
        align="center"
      />
      <a href="/gallery" class="gteaser" data-reveal aria-label="See the full Duke Marine gallery and video">
        <div class="gteaser__imgs" data-galrot>
          {
            galleryPhotos.slice(0, 4).map((p) => (
              <span class="gteaser__cell">
                <img src={p.src} alt={p.alt} loading="lazy" />
              </span>
            ))
          }
        </div>
        <div class="gteaser__video">
          <img src="/media/life/boat-wake.jpg" alt="" class="gteaser__vthumb" loading="lazy" />
          <span class="gteaser__play"><Icon name="play" size={30} /></span>
          <span class="gteaser__cap">Fishing, boating and life on Belize’s waters, shared with Duke Marine</span>
        </div>
        <span class="gteaser__more">Open the full gallery &amp; video <Icon name="arrow" size={18} /></span>
      </a>
    </div>
  </section>

  <!-- Brands strip -->
  <section class="section-tight" style="background: var(--bg-inset)">
    <div class="container">
      <SectionHeader
        eyebrow="Brands we carry"
        title="Gear from names you know"
        align="center"
      />
      <div class="brandlogos" data-reveal data-brandlogos>
        {
          brands.slice(0, 4).map((b) => (
            <a
              href="/brands"
              class:list={['brandlogos__item', { 'brandlogos__item--dark': b.dark }]}
              aria-label="Trusted brands, learn more"
            >
              <img src={b.logo} alt={`${b.name} logo`} loading="lazy" />
            </a>
          ))
        }
      </div>
      <div class="brandcta" data-reveal data-reveal-delay="80">
        <a href="/brands" class="btn btn--gold">
          Click to learn more about these trustworthy brands <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- Why customers choose Duke Marine -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="The Duke Marine difference"
        title="Why Customers Choose Duke Marine"
        align="center"
      />
      <ul class="reasons" role="list">
        {
          reasons.map((r, i) => (
            <li class="reason" data-reveal data-reveal-delay={(i % 5) * 70}>
              <span class="reason__icon"><Icon name={r.icon} size={22} /></span>
              <span class="reason__text">{r.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Visit / hours -->
  <section class="section-tight visit">
    <div class="container">
      <div class="visit__grid">
        <div class="visit__info" data-reveal>
          <span class="eyebrow">Find us</span>
          <h2>Visit the shop</h2>
          <p class="lead">Come talk gear with the team, or reach us any way that’s easy.</p>
          <ul role="list" class="visit__list">
            <li><Icon name="pin" size={20} /> <span>{site.address.line1}, {site.address.city}, {site.address.country}</span></li>
            <li><Icon name="phone" size={20} /> <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></li>
            <li><Icon name="whatsapp" size={20} /> <a href={`https://wa.me/${site.whatsapp}`}>WhatsApp us</a></li>
            <li><Icon name="mail" size={20} /> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          </ul>
          <div class="visit__hours">
            {site.hours.map((h) => (
              <div class="visit__hour">
                <span>{h.day}</span>
                <b>{h.time}</b>
              </div>
            ))}
          </div>
          <a href="/contact" class="btn btn--gold">Get directions &amp; contact <Icon name="arrow" size={18} /></a>
        </div>
        <div class="visit__map" data-reveal data-reveal-delay={120}>
          <iframe
            title="Map to Duke Marine"
            src={mapEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  /* Departments */
  .depts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }
  @media (max-width: 980px) {
    .depts {
      grid-template-columns: 1fr 1fr;
    }
  }
  .dept {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
  .dept:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
  }
}
  .dept__media {
    overflow: hidden;
  }
  .dept__media :global(.media) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
  .dept:hover .dept__media :global(.media) {
    transform: scale(1.06);
  }
}
  .dept__photo {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background: #fff;
    overflow: hidden;
  }
  .dept__photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.2rem;
    box-sizing: border-box;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  /* Lifestyle photos fill the tile edge-to-edge (no white padding). */
  .dept__photo--fill {
    background: var(--c-navy);
  }
  .dept__photo--fill img {
    object-fit: cover;
    padding: 0;
  }
  @media (hover: hover) and (pointer: fine) {
  .dept:hover .dept__photo img {
    transform: scale(1.06);
  }
}
  .dept__photo-label {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background: var(--c-navy);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
  .dept__body {
    padding: 1.8rem 1.8rem 2rem;
  }
  .dept__body h3 {
    font-size: 1.6rem;
  }
  .dept__body > p {
    margin-top: 0.5rem;
    color: var(--text-soft);
  }
  .dept__cats {
    display: grid;
    gap: 0.5rem;
    margin: 1.3rem 0 1.5rem;
  }
  .dept__cats li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: var(--text);
  }
  .dept__cats :global(svg) {
    color: var(--accent-strong);
    flex: none;
  }

  /* Why */
  .why {
    background: var(--grad-deep);
    color: var(--text-invert);
  }
  .why__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.3rem;
    margin-bottom: 3.5rem;
  }
  .why__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.7rem 1.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: transform var(--dur) var(--ease-out), background var(--dur);
  }
  @media (hover: hover) and (pointer: fine) {
  .why__card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.07);
  }
}
  .why__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--grad-current);
    color: var(--c-navy);
    margin: 0 auto 1rem;
  }
  .why__card h3 {
    font-size: 1.15rem;
  }
  .why__card p {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    color: var(--text-soft);
  }

  /* Video split */
  .vsplit {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .vsplit__list {
    display: grid;
    gap: 0.7rem;
    margin: 0 0 1.8rem;
  }
  .vsplit__list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 500;
  }
  .vsplit__list :global(svg) {
    color: var(--accent-strong);
    flex: none;
  }

  /* Brand logos */
  .brandlogos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    transition: opacity 0.45s var(--ease-out);
  }
  .brandlogos.is-swapping {
    opacity: 0;
  }
  .brandlogos__item {
    position: relative;
    width: 170px;
    height: 92px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur), border-color var(--dur);
  }
  .brandlogos__item--dark {
    background: var(--c-navy);
    border-color: color-mix(in srgb, #fff 12%, transparent);
  }
  .brandlogos__item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14px 18px;
    box-sizing: border-box;
  }
  @media (hover: hover) and (pointer: fine) {
  .brandlogos__item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--accent);
  }
}
  .brandcta {
    display: flex;
    justify-content: center;
    margin-top: 1.6rem;
  }

  /* Why customers choose us */
  .reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  .reason {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.9rem;
    padding: 1.1rem 1.3rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .reason__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-strong);
  }
  .reason__text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* Gallery teaser */
  .gteaser {
    display: block;
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }
  .gteaser__imgs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
    transition: opacity 0.45s var(--ease-out);
  }
  .gteaser__imgs.is-swapping {
    opacity: 0;
  }
  .gteaser__cell {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--c-navy);
  }
  .gteaser__cell img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
  .gteaser:hover .gteaser__cell img {
    transform: scale(1.05);
  }
}
  .gteaser__video {
    position: relative;
    margin-top: 0.9rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 7;
    box-shadow: var(--shadow);
  }
  .gteaser__vthumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gteaser__video::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 22, 44, 0.15), rgba(6, 22, 44, 0.65));
  }
  .gteaser__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 74px;
    height: 74px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--c-current);
    color: var(--c-navy);
    z-index: 2;
    box-shadow: 0 8px 24px rgba(6, 22, 44, 0.4);
    transition: transform var(--dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
  .gteaser:hover .gteaser__play {
    transform: scale(1.08);
  }
}
  .gteaser__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1rem;
    z-index: 2;
    text-align: center;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.9rem, 2.4vw, 1.05rem);
    padding-inline: 1rem;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }
  .gteaser__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent-strong);
  }
  @media (hover: hover) and (pointer: fine) {
  .gteaser:hover .gteaser__more :global(svg) {
    transform: translateX(3px);
  }
}
  @media (max-width: 620px) {
    .gteaser__imgs {
      grid-template-columns: 1fr 1fr;
    }
    .gteaser__video {
      aspect-ratio: 16 / 10;
    }
  }

  /* Visit */
  .visit__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .visit__list {
    display: grid;
    gap: 0.9rem;
    margin: 1.5rem 0;
  }
  .visit__list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .visit__list :global(svg) {
    color: var(--accent-strong);
    flex: none;
  }
  .visit__map {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    min-height: 340px;
  }
  .visit__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 340px;
    border: 0;
    filter: grayscale(0.12);
  }
  .visit__hours {
    display: grid;
    gap: 0.4rem;
    padding: 1.2rem 1.4rem;
    background: var(--bg-inset);
    border-radius: var(--radius);
    margin-bottom: 1.6rem;
  }
  .visit__hour {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.92rem;
  }
  .visit__hour span {
    color: var(--text-soft);
  }

  @media (max-width: 860px) {
    .depts {
      grid-template-columns: 1fr;
    }
    .why__grid {
      grid-template-columns: 1fr 1fr;
    }
    .vsplit,
    .visit__grid {
      grid-template-columns: 1fr;
    }
    .vsplit__text {
      order: 1;
    }
    .visit__info {
      text-align: center;
    }
    .visit__list {
      justify-items: center;
    }
    .visit__list li {
      justify-content: center;
    }
    .visit__map {
      width: 100%;
      margin-inline: auto;
    }
  }
  @media (max-width: 520px) {
    .why__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ brandData }}>
  // Home brands: show 4 logos, cross-fade to the next 4 every 8s.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('[data-brandlogos]').forEach((row) => {
    const slots = [...row.querySelectorAll('.brandlogos__item')];
    const per = slots.length;
    if (!per) return;
    const groups = [];
    for (let i = 0; i < brandData.length; i += per) groups.push(brandData.slice(i, i + per));
    if (groups.length < 2 || reduce) return;
    let g = 0;
    const render = (idx) => {
      const grp = groups[idx];
      slots.forEach((slot, i) => {
        const b = grp[i];
        const img = slot.querySelector('img');
        if (!b) {
          slot.style.visibility = 'hidden';
          return;
        }
        slot.style.visibility = '';
        img.src = b.logo;
        img.alt = b.name + ' logo';
        slot.classList.toggle('brandlogos__item--dark', !!b.dark);
      });
    };
    setInterval(() => {
      row.classList.add('is-swapping');
      setTimeout(() => {
        g = (g + 1) % groups.length;
        render(g);
        row.classList.remove('is-swapping');
      }, 460);
    }, 8000);
  });
</script>

<script define:vars={{ galPhotos: galleryPhotos }}>
  // Home gallery teaser: 4 photos, cross-fade to the next 4 every 8s (wraps through all).
  const reduceG = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('[data-galrot]').forEach((grid) => {
    const cells = [...grid.querySelectorAll('img')];
    const n = cells.length;
    if (galPhotos.length <= n || reduceG) return;
    let off = 0;
    setInterval(() => {
      grid.classList.add('is-swapping');
      setTimeout(() => {
        off = (off + n) % galPhotos.length;
        cells.forEach((img, i) => {
          const p = galPhotos[(off + i) % galPhotos.length];
          img.src = p.src;
          img.alt = p.alt;
        });
        grid.classList.remove('is-swapping');
      }, 460);
    }, 8000);
  });
</script>
