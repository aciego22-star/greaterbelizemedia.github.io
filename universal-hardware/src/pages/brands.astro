---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { BRANDS } from '../data/brands';
import { CATEGORY_BY_SLUG, CATEGORIES } from '../data/categories';
import { BRAND_LOGOS } from '../data/site-images';

const onPage = BRANDS.filter((b) => b.onBrandsPage);
const elsewhere = BRANDS.filter((b) => !b.onBrandsPage);
const usedCats = CATEGORIES.filter((c) => BRANDS.some((b) => b.categories.some((l) => l.slug === c.slug)));
---
<Base
  title="Brands"
  description="The brands at Universal Hardware: Makita, Lincoln Electric, ECHO/Shindaiwa, Cub Cadet, Meilun, Lifan, Briggs & Stratton, Westinghouse and more."
  section="brands"
>
  <PageHero
    eyebrow="Brand ecosystem"
    title="The brands behind the range."
    lead="Tools, equipment and appliances from names you know. Filter by category, or ask a branch about a specific line."
    crumbs={[{ label: 'Brands' }]}
  />

  <section class="section section--tight">
    <div class="container">
      <div class="brand-filter" role="group" aria-label="Filter brands by category" data-brand-filter>
        <button type="button" class="chip" aria-pressed="true" data-filter="">All brands <span class="chip-count">{BRANDS.length}</span></button>
        {
          usedCats.map((c) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={c.slug}>
              {c.shortName}
            </button>
          ))
        }
      </div>
      <p class="brand-filter__status" aria-live="polite" data-brand-status>Showing all {BRANDS.length} brands.</p>

      <h2 class="h3 brand-group__title">Featured brands <span class="muted">· {onPage.length}</span></h2>
      <ul class="brand-grid" data-brand-list>
        {
          onPage.map((b) => (
            <li class="brand-card" id={b.id} data-cats={b.categories.map((l) => l.slug).join(' ')}>
              <div class="brand-card__logo">
                {BRAND_LOGOS[b.id] ? (
                  <img src={`/${BRAND_LOGOS[b.id].src}`} width={BRAND_LOGOS[b.id].width} height={BRAND_LOGOS[b.id].height} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="brand-card__nologo" aria-hidden="true"><Icon name="tag" size={22} /></span>
                )}
              </div>
              <h3 class="brand-card__name">{b.name}</h3>
              {b.alsoWritten && <p class="brand-card__aka">Also written: {b.alsoWritten.join(', ')}</p>}
              <p class="brand-card__focus">{b.focus}</p>
              {b.categories.length > 0 && (
                <ul class="brand-card__cats">
                  {b.categories.map((l) => (
                    <li>
                      <a href={`/products/${l.slug}/`}>{CATEGORY_BY_SLUG[l.slug].name}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      <h2 class="h3 brand-group__title">More brands <span class="muted">· {elsewhere.length}</span></h2>
      <ul class="brand-grid brand-grid--compact" data-brand-list>
        {
          elsewhere.map((b) => (
            <li class="brand-card" id={b.id} data-cats={b.categories.map((l) => l.slug).join(' ')}>
              <div class="brand-card__logo">
                {BRAND_LOGOS[b.id] ? (
                  <img src={`/${BRAND_LOGOS[b.id].src}`} width={BRAND_LOGOS[b.id].width} height={BRAND_LOGOS[b.id].height} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="brand-card__nologo" aria-hidden="true"><Icon name="tag" size={22} /></span>
                )}
              </div>
              <h3 class="brand-card__name">{b.name}</h3>
              <p class="brand-card__focus">{b.focus}</p>
              <ul class="brand-card__cats">
                {b.categories.map((l) => (
                  <li><a href={`/products/${l.slug}/`}>{CATEGORY_BY_SLUG[l.slug].name}</a></li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <p class="brand-empty" data-brand-empty hidden>No brands in that category.</p>

    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-brand-filter]');
  const status = document.querySelector<HTMLElement>('[data-brand-status]');
  const empty = document.querySelector<HTMLElement>('[data-brand-empty]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.brand-card'));
  const titles = Array.from(document.querySelectorAll<HTMLElement>('.brand-group__title'));
  const lists = Array.from(document.querySelectorAll<HTMLElement>('[data-brand-list]'));
  root?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const f = btn.dataset.filter || '';
    root.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    let shown = 0;
    cards.forEach((c) => {
      const on = !f || (c.dataset.cats || '').split(' ').includes(f);
      c.hidden = !on;
      if (on) shown++;
    });
    lists.forEach((l, i) => {
      const any = Array.from(l.children).some((c) => !(c as HTMLElement).hidden);
      l.hidden = !any;
      titles[i].hidden = !any;
    });
    if (empty) empty.hidden = shown > 0;
    if (status) status.textContent = f ? `Showing ${shown} ${shown === 1 ? 'brand' : 'brands'} in ${btn.textContent?.trim()}.` : `Showing all ${shown} brands.`;
  });
</script>

<style>
  .brand-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 640px) {
    .brand-filter {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 4px;
      scrollbar-width: none;
    }
    .brand-filter .chip {
      flex: none;
    }
  }
  .brand-filter__status {
    margin-top: 14px;
    font-size: 0.88rem;
    color: var(--steel);
  }
  .brand-group__title {
    margin: 40px 0 16px;
  }
  .brand-group__title[hidden] {
    display: none;
  }
  .brand-grid {
    list-style: none;
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
  }
  .brand-grid[hidden] {
    display: none;
  }
  @media (min-width: 640px) {
    .brand-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .brand-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .brand-grid--compact {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .brand-card {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 22px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--paper);
    scroll-margin-top: calc(var(--header-h) + 24px);
    transition: border-color var(--dur), box-shadow 400ms var(--ease-out);
  }
  .brand-card:target {
    border-color: var(--blue-600);
    box-shadow: 0 0 0 1px var(--blue-600), var(--shadow);
  }
  .brand-card[hidden] {
    display: none;
  }
  .brand-card__logo {
    display: flex;
    align-items: center;
    height: 64px;
    margin-bottom: 4px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .brand-card__logo img {
    width: auto;
    height: auto;
    max-width: min(160px, 100%);
    max-height: 52px;
  }
  .brand-card__nologo {
    color: var(--steel);
  }
  .brand-card__name {
    font-size: 1.55rem;
    font-stretch: 112%;
    letter-spacing: -0.02em;
  }
  .brand-card__aka {
    font-size: 0.78rem;
    color: var(--steel);
    margin-top: -4px;
  }
  .brand-card__focus {
    color: var(--steel);
    font-size: 0.92rem;
  }
  .brand-card__cats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .brand-card__cats li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px 4px 10px;
    border-radius: 999px;
    background: var(--mist);
    border: 1px solid var(--line);
    font-size: 0.8rem;
  }
  .brand-card__cats a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    min-height: 28px;
    display: inline-flex;
    align-items: center;
  }
  .brand-card__cats a:hover {
    color: var(--blue-700);
    text-decoration: underline;
  }
  .brand-empty {
    margin-top: 24px;
    color: var(--steel);
  }
</style>
