---
import Media from './Media.astro';
import Icon from './Icon.astro';
import type { Product } from '../data/products';

interface Props {
  product: Product;
  reveal?: boolean;
  delay?: number;
}
const { product, reveal = true, delay = 0 } = Astro.props;
---

<article
  class="pcard"
  data-cat={product.category}
  data-reveal={reveal ? '' : undefined}
  data-reveal-delay={delay}
>
  <a href={`/products/${product.slug}`} class="pcard__media" tabindex="-1" aria-hidden="true">
    {
      product.image ? (
        <img class="pcard__photo" src={product.image} alt="" loading="lazy" />
      ) : (
        <Media seed={product.seed || product.slug} icon={product.icon} ratio="4 / 3" />
      )
    }
    {product.brand && <span class="pcard__brand">{product.brand}</span>}
  </a>
  <div class="pcard__body">
    <h3 class="pcard__title">
      <a href={`/products/${product.slug}`}>{product.name}</a>
    </h3>
    <p class="pcard__blurb">{product.blurb}</p>
    <div class="pcard__foot">
      <span class="pcard__cta">
        Details <Icon name="arrow" size={16} />
      </span>
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out),
      border-color var(--dur);
  }
  .pcard:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .pcard__media {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .pcard__media :global(.media) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .pcard__photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .pcard:hover .pcard__media :global(.media),
  .pcard:hover .pcard__photo {
    transform: scale(1.05);
  }
  .pcard__brand {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    padding: 0.28rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgba(5, 15, 24, 0.6);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.15rem 1.2rem 1.3rem;
    flex: 1;
  }
  .pcard__title {
    font-size: 1.08rem;
    line-height: 1.25;
  }
  .pcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pcard {
    position: relative;
  }
  .pcard__blurb {
    font-size: 0.88rem;
    color: var(--text-soft);
    flex: 1;
  }
  .pcard__foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.4rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }
  .pcard__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--accent-strong);
    position: relative;
    z-index: 1;
  }
  .pcard:hover .pcard__cta :global(svg) {
    transform: translateX(3px);
  }
</style>
