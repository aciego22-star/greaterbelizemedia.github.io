---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import VideoSection from '../components/VideoSection.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import CtaBanner from '../components/CtaBanner.astro';

// Real photos supplied by the client. Add more to public/media and list here.
const photos = [
  { src: '/media/hero-2.jpg', alt: 'Fishing and diving gear from Duke Marine', span: 'wide', pos: 'center 45%' },
  { src: '/media/hero-1.jpg', alt: 'Duke Marine, where the tide slows', span: 'tall', pos: 'center 20%' },
  { src: '/media/banner-marina.jpg', alt: 'Duke Marine on the Belize City waterfront', span: '', pos: 'center' },
  { src: '/media/poster-sunset.png', alt: 'A Duke Marine skiff at sunset', span: 'tall', pos: 'center' },
  { src: '/media/hero-3.jpg', alt: 'For all your marine needs, Duke Marine', span: 'wide', pos: 'center' },
];

// Placeholder tiles round out the grid until more photos arrive.
const fillers = [
  { seed: 'g-outboard', icon: 'boat', tone: 'current' as const, label: 'Outboards & rigging' },
  { seed: 'g-tackle', icon: 'rod', tone: 'brass' as const, label: 'Rods, reels & tackle' },
  { seed: 'g-dive', icon: 'compass', tone: 'deep' as const, label: 'Dive gear' },
];
---

<BaseLayout
  title="Gallery & Video"
  description="Photos and video from Duke Marine, gear, boats and the crew in Belize City. Marine, fishing and diving supplies, sales and service."
>
  <PageHero
    eyebrow="Gallery & Video"
    title="Straight from the shop"
    lead="Real gear, real boats, real Belize. A look at what’s on the shelves and out on the water."
    crumbs={[{ label: 'Gallery' }]}
  />

  <!-- Photo gallery -->
  <section class="section">
    <div class="container">
      <div class="gal">
        {
          photos.map((p, i) => (
            <figure class:list={['gal__cell', p.span]} data-reveal data-reveal-delay={(i % 3) * 70}>
              <img src={p.src} alt={p.alt} loading="lazy" style={`object-position:${p.pos}`} />
            </figure>
          ))
        }
        {
          fillers.map((f, i) => (
            <figure class="gal__cell" data-reveal data-reveal-delay={(i % 3) * 70}>
              <Media seed={f.seed} icon={f.icon} tone={f.tone} ratio="4 / 3" label={f.label} />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section-tight" style="background: var(--bg-inset)">
    <div class="container">
      <SectionHeader
        eyebrow="Watch"
        title="Video from Duke Marine"
        lead="Product walk-throughs, brand stories and how-tos. Drop us your clips and we’ll feature them here."
      />
      <div class="vids">
        <VideoSection seed="brand-video" poster="/media/banner-marina.jpg" label="Watch: inside Duke Marine" />
        <VideoSection seed="repower-video" poster="/media/poster-sunset.png" label="Watch: outboard rigging" />
      </div>
      <p class="galnote" data-reveal>
        <Icon name="play" size={18} /> Have photos or video of your Duke Marine gear in action?
        <a href="/contact">Send them in</a> and we’ll add them to the gallery.
      </p>
    </div>
  </section>

  <CtaBanner title="Come see it in person" text="The shelves have a lot more than we can fit here, visit the shop or send us your list." />
</BaseLayout>

<style>
  .gal {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 210px;
    gap: 1rem;
  }
  .gal__cell {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--c-navy);
  }
  .gal__cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }
  .gal__cell:hover img {
    transform: scale(1.06);
  }
  .gal__cell.wide {
    grid-column: span 2;
  }
  .gal__cell.tall {
    grid-row: span 2;
  }

  .vids {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
  }
  .galnote {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 2.2rem;
    color: var(--text-soft);
    flex-wrap: wrap;
  }
  .galnote a {
    color: var(--accent-strong);
    font-weight: 600;
  }
  .galnote :global(svg) {
    color: var(--accent-strong);
  }

  @media (max-width: 860px) {
    .gal {
      grid-template-columns: 1fr 1fr;
    }
    .gal__cell.wide {
      grid-column: span 2;
    }
    .gal__cell.tall {
      grid-row: span 1;
    }
    .vids {
      grid-template-columns: 1fr;
    }
  }
</style>
