---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import VideoSection from '../components/VideoSection.astro';
import Icon from '../components/Icon.astro';
import CtaBanner from '../components/CtaBanner.astro';

// Real photos supplied by the client. Add more to public/media and list here.
const photos = [
  { src: '/media/gallery-2.jpg', alt: 'Fishing, diving and marine gear at Duke Marine', span: 'wide', pos: 'center' },
  { src: '/media/gallery-1.jpg', alt: 'Gear on the shelves at Duke Marine', span: '', pos: 'center' },
  { src: '/media/gallery-3.jpg', alt: 'Inside the Duke Marine shop, Belize City', span: 'tall', pos: 'center' },
  { src: '/media/gallery-4.jpg', alt: 'Marine and fishing supplies at Duke Marine', span: '', pos: 'center' },
  { src: '/media/gallery-5.jpg', alt: 'For all your marine needs, Duke Marine', span: 'wide', pos: 'center' },
];

// Client YouTube Shorts, shown as click-to-play thumbnails (vertical 9:16).
const videos = [
  { id: 'BP_keqKlThg', label: 'Duke Marine' },
  { id: 'bIZUxUjjW00', label: 'Duke Marine' },
  { id: '6NAgBH6EkHc', label: 'Duke Marine' },
];
---

<BaseLayout
  title="Gallery & Video"
  description="Photos and video from Duke Marine, gear, boats and the crew in Belize City. Marine, fishing and diving supplies, sales and service."
>
  <PageHero
    eyebrow="Gallery & Video"
    title="Straight from the shop"
    lead="Real gear, real boats, real Belize. A look at what’s on the shelves and out on the water."
    crumbs={[{ label: 'Gallery' }]}
  />

  <!-- Photo gallery -->
  <section class="section">
    <div class="container">
      <div class="gal">
        {
          photos.map((p, i) => (
            <figure class:list={['gal__cell', p.span]} data-reveal data-reveal-delay={(i % 3) * 70}>
              <img src={p.src} alt={p.alt} loading="lazy" style={`object-position:${p.pos}`} />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section-tight" style="background: var(--bg-inset)">
    <div class="container">
      <SectionHeader
        eyebrow="Watch"
        title="Video from Duke Marine"
        lead="Product walk-throughs, brand stories and how-tos. Drop us your clips and we’ll feature them here."
      />
      <div class="vids">
        {
          videos.map((v) => (
            <VideoSection
              embed={`https://www.youtube.com/embed/${v.id}`}
              poster={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
              label={v.label}
              ratio="9 / 16"
            />
          ))
        }
      </div>
      <p class="galnote" data-reveal>
        <Icon name="play" size={18} /> Have photos or video of your Duke Marine gear in action?
        <a href="/contact">Send them in</a> and we’ll add them to the gallery.
      </p>
    </div>
  </section>

  <CtaBanner title="Come see it in person" text="The shelves have a lot more than we can fit here, visit the shop or send us your list." />
</BaseLayout>

<style>
  .gal {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 220px;
    grid-auto-flow: dense;
    gap: 1rem;
  }
  .gal__cell {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--c-navy);
  }
  .gal__cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }
  .gal__cell:hover img {
    transform: scale(1.06);
  }
  .gal__cell.wide {
    grid-column: span 2;
  }
  .gal__cell.tall {
    grid-row: span 2;
  }

  .vids {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .galnote {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 2.2rem;
    color: var(--text-soft);
    flex-wrap: wrap;
  }
  .galnote a {
    color: var(--accent-strong);
    font-weight: 600;
  }
  .galnote :global(svg) {
    color: var(--accent-strong);
  }

  @media (max-width: 860px) {
    .gal {
      grid-template-columns: 1fr 1fr;
    }
    .gal__cell.wide {
      grid-column: span 2;
    }
    .gal__cell.tall {
      grid-row: span 1;
    }
  }
  @media (max-width: 560px) {
    .vids {
      grid-template-columns: 1fr;
      max-width: 320px;
    }
  }
</style>
