---
import OceanCanvas from './OceanCanvas.astro';
import Icon from './Icon.astro';
import { site, primaryCta } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Let’s get you geared up',
  text = 'Tell us what you need for the boat, the water or the reef and our team will help you find the right marine, fishing and diving gear.',
} = Astro.props;
---

<section class="cta on-dark">
  <OceanCanvas />
  <div class="container cta__inner" data-reveal>
    <div class="cta__text">
      <span class="eyebrow">Ready when you are</span>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta__actions">
      <a href={primaryCta.href} class="btn btn--gold btn--lg">{primaryCta.label} <Icon name="arrow" size={18} /></a>
      <a href={`https://wa.me/${site.whatsapp}`} class="btn btn--ghost btn--lg">
        <Icon name="whatsapp" size={18} /> WhatsApp us
      </a>
      <a href={`tel:${site.phoneHref}`} class="cta__phone">
        <Icon name="phone" size={18} /> {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    color: var(--text-invert);
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }
  .cta__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .cta h2 {
    margin-top: 0.8rem;
    font-size: var(--fs-h2);
  }
  .cta .lead {
    margin-top: 1rem;
    color: #cfe4e6;
  }
  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .cta__actions .btn {
    width: 100%;
  }
  .cta__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-current-bright);
    margin-top: 0.3rem;
  }
  @media (max-width: 820px) {
    .cta__inner {
      grid-template-columns: 1fr;
    }
    .cta__actions {
      align-items: stretch;
    }
  }
</style>
