---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import Reveal from '../components/Reveal.astro';
import CtaBanner from '../components/CtaBanner.astro';

const services = [
  {
    icon: 'rod',
    title: 'Reel service & line spooling',
    text: 'Bring your reels in for service, or spool fresh braid, mono or fluorocarbon at our in-store line station, matched to your setup.',
    points: ['Reel servicing', 'Braid & mono spooling', 'Setup advice'],
  },
  {
    icon: 'tag',
    title: 'Special orders',
    text: 'If it’s not on the shelf, we’ll source it. Tell us the make and model and we’ll track down parts and gear from our full range.',
    points: ['Parts sourcing', 'Brand requests', 'Order tracking'],
  },
  {
    icon: 'shield',
    title: 'Safety gear & compliance',
    text: 'We help you meet inspection requirements with in-date life-saving and signalling equipment, and advice on what you need aboard.',
    points: ['PFDs & flares', 'Extinguishers', 'Compliance advice'],
  },
  {
    icon: 'compass',
    title: 'Gear advice & fitting',
    text: 'Not sure what fits? Our team helps match electronics, tackle and safety gear to your vessel and the water you run.',
    points: ['Fitment checks', 'Electronics advice', 'Tackle matching'],
  },
];

const steps = [
  { n: '01', title: 'Tell us what you need', text: 'Call, message or drop in with your vessel, engine or gear details.' },
  { n: '02', title: 'We spec & quote', text: 'Our team recommends the right parts or gear and gives you clear pricing.' },
  { n: '03', title: 'We set it up', text: 'Rigging, spooling and testing happen in-house before anything leaves.' },
  { n: '04', title: 'Back on the water', text: 'Pick it up ready to go, and we’re here for parts and service after.' },
];
---

<BaseLayout
  title="Services"
  description="Duke Marine offers reel service and line spooling, special orders, gear fitting and safety compliance in Belize City."
>
  <PageHero
    eyebrow="Services"
    title="More than a counter, a service bench"
    lead="We don’t just sell the gear; we set it up, service it and keep you supplied. Here’s how we help."
    crumbs={[{ label: 'Services' }]}
  />

  <!-- Services grid -->
  <section class="section">
    <div class="container">
      <div class="svc">
        {
          services.map((s, i) => (
            <Reveal class="svc__card" delay={(i % 3) * 80}>
              <span class="svc__icon"><Icon name={s.icon} size={26} /></span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <ul role="list" class="svc__points">
                {s.points.map((p) => <li><Icon name="check" size={15} /> {p}</li>)}
              </ul>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section on-dark" style="background: var(--grad-deep)">
    <div class="container">
      <SectionHeader eyebrow="How it works" title="Simple, from enquiry to on the water" align="center" />
      <div class="steps">
        {
          steps.map((s, i) => (
            <Reveal class="step" delay={i * 80}>
              <span class="step__n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner title="Need something set up?" text="Tell us about your vessel, engine or gear and we’ll take it from there." />
</BaseLayout>

<style>
  .svc {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  .svc__card {
    padding: 1.8rem 1.6rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur), border-color var(--dur);
  }
  .svc__card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .svc__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 15px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-strong);
    margin-bottom: 1rem;
    transition: transform var(--dur), background var(--dur), color var(--dur);
  }
  .svc__card:hover .svc__icon {
    transform: rotate(-6deg);
    background: var(--accent);
    color: #fff;
  }
  .svc__card h3 {
    font-size: 1.2rem;
  }
  .svc__card > p {
    margin-top: 0.5rem;
    color: var(--text-soft);
    font-size: 0.92rem;
  }
  .svc__points {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .svc__points li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .svc__points :global(svg) {
    color: var(--accent-strong);
    flex: none;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.3rem;
    counter-reset: step;
  }
  .step {
    position: relative;
    padding: 1.7rem 1.4rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .step__n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
    background: var(--grad-current);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .step h3 {
    margin-top: 0.6rem;
    font-size: 1.1rem;
  }
  .step p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: var(--text-soft);
  }

  @media (max-width: 860px) {
    .svc {
      grid-template-columns: 1fr 1fr;
    }
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .svc {
      grid-template-columns: 1fr;
    }
  }
</style>
