---
/**
 * Full-image hero slideshow, cross-fades the client's brand photos every 7s.
 * Each slide shows the WHOLE image (contain) in any orientation, over a blurred
 * fill of itself so there are no empty bars. Respects prefers-reduced-motion.
 * Swap/add images in public/media and edit the `slides` array below.
 */
// Each slide has a portrait poster (mobile) and a dedicated landscape banner
// (desktop). Mobile shows the portrait via contain+blur; desktop shows the whole
// landscape banner (no crop) below the header. Swap/add images in public/media.
// A slide with `href` renders as a clickable link (whole slide navigates);
// slides without `href` are decorative images.
const slides = [
  { src: '/media/hero-catch.jpg', desktop: '/media/hero-catch-desktop.jpg', label: 'Built for the catch, fishing, diving and boat supplies' },
  { src: '/media/hero-dive.jpg', desktop: '/media/hero-dive-desktop.jpg', label: 'Every great dive starts with the right gear' },
  // Mobile poster falls back to the wide banner (shown whole via contain+blur)
  // until the dedicated portrait `hero-careers.jpg` is supplied; swap `src` then.
  { src: '/media/hero-careers-desktop.jpg', desktop: '/media/hero-careers-desktop.jpg', href: '/careers', label: 'Careers at Duke Marine. Explore current employment opportunities.' },
];
---

<section class="hero on-dark">
  <h1 class="visually-hidden">Duke Marine, marine, fishing &amp; diving supplies in Belize City</h1>

  <div class="hero__slides" data-hero-slides aria-label="Duke Marine">
    {
      slides.map((s, i) =>
        s.href ? (
          <a
            class:list={['hero__slide', { 'is-active': i === 0 }]}
            href={s.href}
            aria-label={s.label}
          >
            <div class="hero__slide-blur" style={`background-image:url(${s.src})`}></div>
            <div class="hero__slide-img" style={`background-image:url(${s.src})`}></div>
            <div class="hero__slide-desk" style={`background-image:url(${s.desktop})`}></div>
          </a>
        ) : (
          <div class:list={['hero__slide', { 'is-active': i === 0 }]} role="img" aria-label={s.label}>
            <div class="hero__slide-blur" style={`background-image:url(${s.src})`}></div>
            <div class="hero__slide-img" style={`background-image:url(${s.src})`}></div>
            <div class="hero__slide-desk" style={`background-image:url(${s.desktop})`}></div>
          </div>
        ),
      )
    }
  </div>
  <div class="hero__scrim"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: flex-end;
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--text-invert);
    overflow: hidden;
    background: var(--c-navy);
  }
  .hero__slides {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  /* a clickable slide (e.g. Careers) fills the frame and shows no link chrome */
  a.hero__slide {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  /* visible focus state for keyboard users (pointer clicks stay clean) */
  a.hero__slide:focus-visible {
    outline: 3px solid var(--gold, #e6b83f);
    outline-offset: -3px;
  }
  /* blurred fill (no empty bars) */
  .hero__slide-blur {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(28px) brightness(0.55);
    transform: scale(1.12);
  }
  /* the full image, shown whole in any orientation */
  .hero__slide-img {
    position: absolute;
    inset: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }
  /* desktop-only landscape banner layer (hidden on mobile) */
  .hero__slide-desk {
    display: none;
  }
  /* subtle top scrim so the (transparent) desktop nav stays legible */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(6, 22, 44, 0.74) 0%,
      rgba(6, 22, 44, 0.18) 24%,
      rgba(6, 22, 44, 0) 46%
    );
  }
  /* Desktop: show the dedicated LANDSCAPE banner whole (no crop, no side bars),
     seated in the area right below the header. The hero reserves the header
     height on top (its navy fills behind the fixed, transparent header); the
     slides box takes the banner's native aspect so the full poster is always
     visible. Mobile is untouched (portrait poster, contain + blur). */
  @media (min-width: 981px) {
    .hero {
      display: block;
      min-height: 0;
      height: auto;
      align-items: initial;
      padding-top: var(--header-h);
      padding-bottom: 0;
    }
    .hero__slides {
      position: relative;
      width: 100%;
      aspect-ratio: 1672 / 941;
    }
    .hero__slide-blur,
    .hero__slide-img {
      display: none;
    }
    .hero__slide-desk {
      display: block;
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
    /* banner carries its own branding; drop the nav scrim so it stays clean */
    .hero__scrim {
      display: none;
    }
  }
  /* On mobile the header is opaque (bar + quick-nav strip). Drop the sharp
     poster below the header so its top (the DUKE MARINE wordmark) is never
     hidden; the blurred fill stays full-bleed behind the header. */
  @media (max-width: 980px) {
    .hero__slide-img {
      top: calc(var(--header-h) + 3.25rem);
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: calc(var(--header-h) + 3.6rem);
    }
    .hero__slide-blur {
      filter: blur(22px) brightness(0.55);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: opacity 0.01s;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-hero-slides]').forEach((wrap) => {
    const slides = [...wrap.querySelectorAll<HTMLElement>('.hero__slide')];
    if (slides.length < 2 || reduce) return;
    let i = 0;
    let timer = 0;
    const go = () => {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    };
    const start = () => {
      stop();
      timer = window.setInterval(go, 7000);
    };
    const stop = () => timer && window.clearInterval(timer);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  });
</script>
