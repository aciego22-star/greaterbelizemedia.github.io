---
import BaseLayout from '../layouts/BaseLayout.astro';
import DepartmentCatalog from '../components/DepartmentCatalog.astro';
import { departments } from '../data/catalog';

// The same label DepartmentCatalog renders in the visible breadcrumbs.
const crumbs = [{ label: departments.marine.title }];
---

<BaseLayout
  breadcrumbs={crumbs}
  title="Marine Supplies"
  description="Anchors, rope and fenders, bilge pumps, electrical and lighting, stainless hardware, bimini and canvas, trailer parts, fiberglass, props and safety gear at Duke Marine, Belize."
>
  <DepartmentCatalog dept="marine" />
</BaseLayout>
