---
import BaseLayout from '../layouts/BaseLayout.astro';
import DepartmentCatalog from '../components/DepartmentCatalog.astro';
import { departments } from '../data/catalog';

// The same label DepartmentCatalog renders in the visible breadcrumbs.
const crumbs = [{ label: departments.fishing.title }];
---

<BaseLayout
  breadcrumbs={crumbs}
  title="Fishing Supplies"
  description="Fishing supplies in Belize at Duke Marine, rods, reels, line, leader, hooks, swivels, sinkers, lures, cast nets and tackle boxes for flats, reef and blue-water fishing."
>
  <DepartmentCatalog dept="fishing" />
</BaseLayout>
