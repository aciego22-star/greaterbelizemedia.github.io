---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import CtaBanner from '../components/CtaBanner.astro';

// Verified heritage facts only (client-confirmed).
const heritage = [
  { icon: 'clock', label: 'Established 1991' },
  { icon: 'users', label: 'Founded by Paul & Ruth Duke' },
  { icon: 'anchor', label: 'Belize’s First Marine Store' },
  { icon: 'boat', label: 'Marine, Fishing & Diving Supplies' },
];
---

<BaseLayout
  title="About Us"
  description="Duke Marine has served Belize’s boating, fishing and diving community since 1991, founded by Paul and Ruth Duke as Belize’s first dedicated marine store."
>
  <PageHero
    eyebrow="Our Story"
    title="Built on Experience. Trusted for Generations."
    lead="Serving Belize’s boating, fishing and diving community since 1991."
    crumbs={[{ label: 'About' }]}
    image="/media/life/caye-approach.jpg"
    imageAlt="Approaching a caye across Belize’s waters"
    imagePosition="center 55%"
  />

  <!-- Story -->
  <section class="section">
    <div class="container story">
      <div class="story__media" data-reveal>
        <img
          src="/media/gallery-1.jpg"
          alt="A display of Duke Marine fishing, diving and boating gear laid out in Belize City"
          class="story__img"
          loading="lazy"
        />
      </div>
      <div class="story__text" data-reveal data-reveal-delay="100">
        <span class="eyebrow">Marine Parts · Sales · Service</span>
        <h2>Trusted for generations on Belize’s water</h2>
        <div class="prose stack" style="--flow: 1.1rem">
          <p>Duke Marine has proudly served Belize’s boating, fishing and diving community since 1991, when Paul and Ruth Duke opened what would become Belize’s first dedicated marine store.</p>
          <p>What began as a family business built on honest advice, dependable products and exceptional customer service has grown into one of the country’s most trusted names in marine supplies. For more than three decades, commercial fishermen, tour operators, boat owners, divers and recreational anglers have relied on Duke Marine for quality equipment and knowledgeable service.</p>
          <p>While the marine industry has evolved, our philosophy has remained the same. We believe every customer deserves reliable products, practical guidance and a team committed to helping them find what they need.</p>
          <p>Today, Duke Marine continues that tradition while embracing the future. From expanding our product range to preparing a searchable online marine-parts catalogue, we remain committed to making it easier for customers to find the right equipment and confidently return to the water.</p>
          <p>Whether you are preparing for a day offshore with the right <a href="/fishing-supplies">fishing supplies</a>, maintaining a vessel with <a href="/marine-supplies">marine parts and supplies</a>, stocking a tour operation or planning your next dive with our <a href="/diving-supplies">diving supplies</a>, Duke Marine is here to help, just as we have been since 1991.</p>
        </div>
        <div class="story__sign">
          <strong>A family-owned Belizean business, proudly serving the marine community since 1991.</strong>
          <span>Philip Goldson Highway · Belize City, Belize</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand quote -->
  <section class="quoteband on-dark">
    <div class="container quoteband__inner" data-reveal>
      <Icon name="quote" size={40} class="quoteband__mark" />
      <p class="quoteband__text">Family-run since 1991, trusted on Belize’s water for generations.</p>
      <span class="quoteband__sub">Marine · Fishing · Diving Supplies</span>
    </div>
  </section>

  <!-- Heritage strip (verified facts only) -->
  <section class="section-tight" style="background: var(--bg-inset)">
    <div class="container">
      <SectionHeader eyebrow="Our heritage" title="More than three decades on the water" align="center" />
      <div class="heritage">
        {
          heritage.map((h, i) => (
            <div class="heritage__item" data-reveal data-reveal-delay={i * 80}>
              <span class="heritage__icon"><Icon name={h.icon} size={24} /></span>
              <span class="heritage__label">{h.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner title="Come say hello" text="Stop by the shop on the Philip Goldson Highway, or reach us by phone, email or WhatsApp. We’re always happy to help you find the right gear." />
</BaseLayout>

<style>
  .story {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .story__media {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .story__img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .story__text h2 {
    margin: 0.7rem 0 1.3rem;
  }
  .story__sign {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 1.8rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }
  .story__sign strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.35;
  }
  .story__sign span {
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .quoteband {
    background: var(--grad-deep);
    color: var(--text-invert);
    text-align: center;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .quoteband__inner {
    max-width: 800px;
  }
  .quoteband__mark {
    color: var(--gold);
    opacity: 0.5;
    margin: 0 auto 1rem;
  }
  .quoteband__text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .quoteband__sub {
    display: block;
    margin-top: 1.1rem;
    color: var(--gold);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .heritage {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.3rem;
  }
  .heritage__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.8rem;
    padding: 1.7rem 1.3rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .heritage__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-strong);
  }
  .heritage__label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
  }

  @media (max-width: 860px) {
    .story {
      grid-template-columns: 1fr;
    }
    .heritage {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 460px) {
    .heritage {
      grid-template-columns: 1fr;
    }
  }
</style>
