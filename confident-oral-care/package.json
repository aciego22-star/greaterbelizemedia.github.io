{
  "name": "confident-oral-care",
  "version": "0.1.0",
  "private": true,
  "description": "ConfiDent Oral Care website preview with confident AI and a test booking calendar.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "images": "python3 scripts/build-images.py",
    "start:env": "node --env-file=.env src/server.mjs",
    "export": "node scripts/export-static.mjs --single"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@netlify/blobs": "^11.1.9"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
