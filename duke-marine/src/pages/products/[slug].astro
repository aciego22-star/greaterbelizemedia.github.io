---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { products, getProduct } from '../../data/products';
import { departments, categoryName } from '../../data/catalog';
import { site } from '../../data/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProduct(slug!);
if (!product) return Astro.redirect('/404');

const dept = departments[product.department];
const catName = categoryName(product.department, product.category);
const related = products
  .filter((p) => p.department === product.department && p.slug !== product.slug)
  .slice(0, 3);

const waMsg = encodeURIComponent(`Hi Duke Marine, I'm interested in the ${product.name}. Is it in stock?`);
---

<BaseLayout title={product.name} description={product.blurb} solidHeader={true}>
  <article class="pdp">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <Icon name="chevron" size={14} class="crumbs__sep" />
        <a href={dept.href}>{dept.title}</a>
        <Icon name="chevron" size={14} class="crumbs__sep" />
        <span aria-current="page">{product.name}</span>
      </nav>

      <div class="pdp__grid">
        <div class="pdp__media" data-reveal>
          <Media seed={product.seed || product.slug} icon={product.icon} ratio="4 / 3" />
        </div>

        <div class="pdp__info" data-reveal data-reveal-delay="80">
          <div class="pdp__tags">
            {product.brand && <span class="pill">{product.brand}</span>}
            <a href={`${dept.href}#${product.category}`} class="pill pill--link">{catName}</a>
          </div>
          <h1>{product.name}</h1>
          <p class="lead">{product.blurb}</p>

          {product.description && <p class="pdp__desc">{product.description}</p>}

          {
            product.priceFrom ? (
              <div class="pdp__price">
                <span class="pdp__price-cur">BZD</span>
                <span class="pdp__price-num">${product.priceFrom.toLocaleString()}</span>
                {product.unit && <span class="pdp__price-unit">{product.unit}</span>}
              </div>
            ) : (
              <div class="pdp__price pdp__price--ask">Ask in-store for pricing</div>
            )
          }
          <p class="pdp__pricenote">Indicative pricing, contact us for the latest and for volume discounts.</p>

          {
            product.specs && (
              <ul class="pdp__specs" role="list">
                {product.specs.map((s) => (
                  <li>
                    <span>{s.label}</span>
                    <b>{s.value}</b>
                  </li>
                ))}
              </ul>
            )
          }

          <div class="pdp__actions">
            <a href="/contact#quote" class="btn btn--gold btn--lg">Request this item <Icon name="arrow" size={18} /></a>
            <a href={`https://wa.me/${site.whatsapp}?text=${waMsg}`} class="btn btn--ghost btn--lg">
              <Icon name="whatsapp" size={18} /> Ask on WhatsApp
            </a>
          </div>

          <ul class="pdp__assure" role="list">
            <li><Icon name="check" size={16} /> In-house setup &amp; testing</li>
            <li><Icon name="check" size={16} /> Expert fitting advice</li>
            <li><Icon name="truck" size={16} /> Delivery &amp; commercial supply</li>
          </ul>
        </div>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="pdp__related-title" data-reveal>More from {dept.title}</h2>
          <div class="grid auto-fit" style="--min: 250px">
            {related.map((p, i) => <ProductCard product={p} delay={i * 70} />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaBanner />
</BaseLayout>

<style>
  .pdp {
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: var(--section-y);
    background:
      radial-gradient(80% 60% at 100% 0%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 60%);
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    font-size: 0.82rem;
    color: var(--text-soft);
  }
  .crumbs a:hover {
    color: var(--accent-strong);
  }
  .crumbs__sep {
    transform: rotate(-90deg);
    opacity: 0.5;
  }
  .crumbs [aria-current] {
    color: var(--text);
    font-weight: 600;
  }
  .pdp__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .pdp__media {
    position: sticky;
    top: 100px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .pdp__tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .pill--link:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }
  .pdp__info h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }
  .pdp__info .lead {
    margin-top: 0.9rem;
  }
  .pdp__desc {
    margin-top: 1rem;
    color: var(--text-soft);
  }
  .pdp__price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-family: var(--font-display);
  }
  .pdp__price-cur {
    font-size: 0.9rem;
    color: var(--text-soft);
    font-weight: 600;
  }
  .pdp__price-num {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text);
  }
  .pdp__price-unit {
    font-size: 0.9rem;
    color: var(--text-soft);
  }
  .pdp__price--ask {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--accent-strong);
  }
  .pdp__pricenote {
    font-size: 0.8rem;
    color: var(--text-soft);
    margin-top: 0.3rem;
  }
  .pdp__specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin: 1.6rem 0;
    padding: 1.3rem;
    background: var(--bg-inset);
    border-radius: var(--radius);
  }
  .pdp__specs li {
    display: flex;
    flex-direction: column;
  }
  .pdp__specs span {
    font-size: 0.75rem;
    color: var(--text-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pdp__specs b {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .pdp__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 1.8rem 0 1.4rem;
  }
  .pdp__assure {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
  }
  .pdp__assure li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-soft);
  }
  .pdp__assure :global(svg) {
    color: var(--accent-strong);
  }
  .pdp__related-title {
    margin-bottom: 2rem;
  }
  @media (max-width: 820px) {
    .pdp__grid {
      grid-template-columns: 1fr;
    }
    .pdp__media {
      position: static;
    }
  }
</style>
