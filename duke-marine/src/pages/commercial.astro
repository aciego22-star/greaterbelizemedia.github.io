---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import NetlifyForm from '../components/NetlifyForm.astro';
import Reveal from '../components/Reveal.astro';

const audiences = [
  { icon: 'fish', title: 'Commercial fishermen & co-ops', text: 'Volume tackle, line, ice and safety gear to keep your crews productive and compliant.' },
  { icon: 'boat', title: 'Resorts & fishing lodges', text: 'Fleet outboards, rigging, guest tackle and standing orders — supplied and delivered on schedule.' },
  { icon: 'compass', title: 'Dive & tour operators', text: 'Safety equipment, hardware and consumables for busy day-boat and charter operations.' },
  { icon: 'truck', title: 'Government & marine contractors', text: 'Bulk provisioning, documented quotes and reliable resupply for project fleets.' },
];

const benefits = [
  'Trade & wholesale pricing on volume',
  'Dedicated account contact',
  'Standing / recurring orders',
  'Priority special-ordering',
  'Delivery across the district',
  'Documented quotes for procurement',
];
---

<BaseLayout
  title="Commercial & Wholesale"
  description="Duke Marine supplies Belize’s commercial fishermen, resorts, dive operators and fleets with wholesale pricing, standing orders, delivery and dedicated account support."
>
  <PageHero
    eyebrow="Commercial & Wholesale"
    title="Provisioning for Belize’s working waterfront"
    lead="From single lodges to whole fleets, we keep commercial operators supplied — with trade pricing, standing orders and delivery."
    crumbs={[{ label: 'Commercial' }]}
  >
    <div class="chero__actions" data-reveal data-reveal-delay="180">
      <a href="#account" class="btn btn--gold">Open a trade account <Icon name="arrow" size={18} /></a>
    </div>
  </PageHero>

  <!-- Audiences -->
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Who we supply" title="Built for operators who can’t afford downtime" />
      <div class="aud">
        {
          audiences.map((a, i) => (
            <Reveal class="aud__card" delay={i * 80}>
              <span class="aud__icon"><Icon name={a.icon} size={24} /></span>
              <div>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Benefits split -->
  <section class="section on-dark" style="background: var(--grad-deep)">
    <div class="container bsplit">
      <div class="bsplit__text" data-reveal>
        <span class="eyebrow">Account benefits</span>
        <h2>The support behind the supply</h2>
        <p class="lead">A Duke Marine trade account is more than a discount — it’s a partner who keeps your operation stocked and running.</p>
        <ul class="benefits" role="list">
          {benefits.map((b) => <li><Icon name="check" size={18} /> {b}</li>)}
        </ul>
      </div>
      <Reveal class="bsplit__media" delay={120}>
        <Media seed="commercial" icon="truck" ratio="4 / 5" tone="current" pattern="waves" label="Fleet & wholesale supply" />
      </Reveal>
    </div>
  </section>

  <!-- Trade account form -->
  <section id="account" class="section">
    <div class="container form-wrap">
      <div class="form-wrap__intro" data-reveal>
        <span class="eyebrow">Get started</span>
        <h2>Open a trade account</h2>
        <p class="lead">Tell us about your operation and we’ll set you up with pricing and a dedicated contact. We typically respond within one business day.</p>
        <ul class="form-wrap__points" role="list">
          <li><Icon name="check" size={18} /> No obligation to enquire</li>
          <li><Icon name="check" size={18} /> Volume &amp; recurring pricing</li>
          <li><Icon name="check" size={18} /> Delivery options discussed</li>
        </ul>
      </div>
      <div class="form-wrap__form card" data-reveal data-reveal-delay="100">
        <NetlifyForm name="commercial-account" variant="commercial" submitLabel="Request trade account" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .chero__actions {
    margin-top: 2rem;
  }
  .aud {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.3rem;
  }
  .aud__card {
    display: flex;
    gap: 1.1rem;
    padding: 1.6rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
  }
  .aud__card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
  }
  .aud__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-strong);
  }
  .aud__card h3 {
    font-size: 1.15rem;
  }
  .aud__card p {
    margin-top: 0.4rem;
    color: var(--text-soft);
    font-size: 0.92rem;
  }

  .bsplit {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .bsplit h2 {
    margin: 0.7rem 0 1rem;
  }
  .benefits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
    margin-top: 1.6rem;
  }
  .benefits li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 500;
  }
  .benefits :global(svg) {
    color: var(--c-current-bright);
    flex: none;
  }
  .bsplit__media {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .form-wrap {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .form-wrap__intro h2 {
    margin: 0.7rem 0 1rem;
  }
  .form-wrap__points {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .form-wrap__points li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .form-wrap__points :global(svg) {
    color: var(--accent-strong);
  }
  .form-wrap__form {
    padding: 1.8rem;
  }

  @media (max-width: 820px) {
    .aud,
    .benefits {
      grid-template-columns: 1fr;
    }
    .bsplit,
    .form-wrap {
      grid-template-columns: 1fr;
    }
    .bsplit__media {
      order: -1;
    }
  }
</style>
