---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Checkout from '../islands/Checkout.tsx';
import '../styles/shop.css';
---
<Base title="Checkout" description="Universal Hardware checkout: collect at Spanish Lookout or Belize City." section="shop">
  <PageHero title="Checkout" crumbs={[{ href: '/shop/', label: 'Shop' }, { href: '/cart/', label: 'Cart' }, { label: 'Checkout' }]} />
  <section class="section section--tight">
    <div class="container">
      <Checkout client:load />
      <noscript><p class="notice">Checkout needs JavaScript.</p></noscript>
    </div>
  </section>
</Base>
