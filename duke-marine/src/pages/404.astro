---
import BaseLayout from '../layouts/BaseLayout.astro';
import OceanCanvas from '../components/OceanCanvas.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" noindex={true}>
  <section class="nf on-dark">
    <OceanCanvas />
    <div class="container nf__inner" data-reveal>
      <span class="nf__code">404</span>
      <h1>Off the chart</h1>
      <p class="lead">The page you’re looking for has drifted off course. Let’s get you back to safe harbour.</p>
      <div class="nf__actions">
        <a href="/" class="btn btn--gold btn--lg">Back to home <Icon name="arrow" size={18} /></a>
        <a href="/contact" class="btn btn--ghost btn--lg">Contact us</a>
      </div>
      <div class="nf__links">
        <a href="/marine-supplies">Marine Supplies</a>
        <a href="/fishing-supplies">Fishing Supplies</a>
        <a href="/brands">Brands</a>
        <a href="/blog">Blog</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    min-height: 84vh;
    display: flex;
    align-items: center;
    text-align: center;
    color: var(--text-invert);
    overflow: hidden;
    padding-top: calc(var(--header-offset) + 3rem);
    padding-bottom: 4rem;
  }
  .nf__inner {
    max-width: 620px;
    margin: 0 auto;
  }
  .nf__code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 9rem);
    line-height: 1;
    background: var(--grad-current);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf h1 {
    margin-top: 0.5rem;
    font-size: var(--fs-h2);
  }
  .nf .lead {
    margin-top: 1rem;
    color: #d3e6e8;
  }
  .nf__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
  .nf__links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 2.5rem;
    padding-top: 1.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .nf__links a {
    color: #a9c4d1;
    font-weight: 600;
    font-size: 0.9rem;
  }
  @media (hover: hover) and (pointer: fine) {
  .nf__links a:hover {
    color: #fff;
  }
}
</style>
