  circle: '<circle cx="12" cy="12" r="9"/>',
};

const inner = paths[name] ?? paths['circle'];
const aria = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true' };
---

<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...aria}
  set:html={inner}
/>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
