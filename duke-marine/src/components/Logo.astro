---
/**
 * Duke Marine brand lockup: the real anchor badge + wordmark.
 * The badge (public/media/logo.jpg) carries the brand; the wordmark keeps
 * the name crisp at small sizes and on any background.
 */
interface Props {
  class?: string;
  compact?: boolean;
}
const { class: cls = '', compact = false } = Astro.props;
---

<a href="/" class:list={['logo', cls]} aria-label="Duke Marine, home">
  <img
    src="/media/logo.jpg"
    alt="Duke Marine"
    class="logo__badge"
    width="46"
    height="46"
    loading="eager"
  />
  {
    !compact && (
      <span class="logo__type">
        <strong>DUKE&nbsp;MARINE</strong>
        <span>Marine Parts · Sales · Service</span>
        <span class="logo__tag2">Fishing · Diving · Boat Supplies</span>
      </span>
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: inherit;
  }
  .logo__badge {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
    transition: transform var(--dur) var(--ease-out);
  }
  .logo:hover .logo__badge {
    transform: rotate(-6deg) scale(1.04);
  }
  .logo__type {
    display: flex;
    flex-direction: column;
    gap: 0.16rem;
    line-height: 1.1;
    font-family: var(--font-display);
  }
  .logo__type strong {
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    color: var(--gold, #e6b83f);
    margin-bottom: 0.12rem;
  }
  .logo__type span {
    font-size: 0.62rem;
    font-weight: 600;
    color: #ffffff;
    opacity: 0.9;
    letter-spacing: 0.16em;
    line-height: 1.25;
    text-transform: uppercase;
  }
  .logo__tag2 {
    opacity: 0.72 !important;
    letter-spacing: 0.14em !important;
  }
  /* Decongest the header on mobile: keep the badge + wordmark, drop the taglines. */
  @media (max-width: 980px) {
    .logo {
      gap: 0.55rem;
    }
    .logo__type span {
      display: none;
    }
    .logo__type strong {
      font-size: 1.15rem;
      letter-spacing: 0.06em;
    }
  }
</style>
