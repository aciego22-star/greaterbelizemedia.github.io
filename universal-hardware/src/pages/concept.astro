---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { SOURCE_VIEWED } from '../data/sources';

const works = [
  ['Shop, cart & checkout', '32 Makita tools and Lifan and Meilun motorcycles with the model, description and price printed in the company’s February 2026 sale graphics, a cart, and a checkout with branch collection and a credit/debit card step that runs in demo mode.'],
  ['Category explorer & search', 'Instant search across 12 categories, their listed product types and brands, with department and brand filters.'],
  ['Category pages', 'A landing page for every category, with listed product types, brand mentions and preparation tips.'],
  ['Product finder', 'Six guided paths with two or three questions each, mapping answers to listed categories using fixed local rules.'],
  ['Enquiry Summary', 'Add, remove, copy and reset a plain-text summary. It stays in this browser tab and is never sent.'],
  ['Product Guide', 'A rule-based conversational guide in English and Spanish. It is not live AI.'],
  ['Branch details', 'Website-listed addresses, hours, phone and WhatsApp numbers, with a session-only branch preference.'],
  ['Homepage slideshow', 'Three full-width concept images (storefront, store floor, paint aisle) above the 3D hero, with separate desktop and mobile compositions, a 7-second fade, and pause, dot, swipe and arrow-key controls.'],
  ['Real-time 3D hero', 'The Makita 12V drill from Universal Hardware’s own 2026 promotion, built in 3D from the company’s product photo and rendered with WebGL, with pause, reduced-motion and static fallbacks.'],
];
const illustrative = [
  'The homepage slideshow images are concept images supplied for this presentation. They are not photographs of a Universal Hardware branch, and the people in them are not staff or customers.',
  'Shop prices are the sale prices printed in Universal Hardware’s Friends & Family Sale graphics (Spanish Lookout, 19–21 February 2026). That sale has ended: the prices show how checkout works and are not a current price list. GST treatment, delivery and returns terms are not stated.',
  'The 3D drill kit (drill, 1.5Ah battery and charger) is built from the product photo in Universal Hardware’s February 2026 promotion. Its depth is estimated from the photo’s outline, and the far side mirrors the near side. It does not confirm current stock.',
  'Every product photo and brand logo is an image from Universal Hardware’s current website. The photos show example products, not confirmed stock or current models.',
  'Category descriptions are concept copy summarising Universal Hardware’s public pages.',
  'Department groupings (for example “Welding & Shop Equipment”) are a proposed navigation structure.',
  'Headlines such as “Built for Every Job.” are proposed concept copy, not a company slogan.',
];
const privacy = [
  ['No data collection', 'No forms submit anywhere. Checkout contact details stay in the page’s memory and are discarded when you leave it. No analytics, tracking pixels, cookies or third-party scripts are loaded.'],
  ['Session-only memory', 'Your cart, Enquiry Summary, preferred branch and motion setting stay in this browser tab (sessionStorage) and are cleared when it closes.'],
  ['Guide conversations', 'Kept in memory only and discarded when you leave the page. Nothing you type is transmitted.'],
  ['Outbound links on tap only', 'Phone, WhatsApp, maps, email and official-website links open only when you choose them.'],
];
const payments = [
  ['Merchant account in Universal Hardware’s name', 'Universal Hardware applies to its bank or a card processor. The account, the money and the customer relationship are the company’s own; underwriting reviews the business and this website.'],
  ['Processor-hosted card fields', 'The processor’s secure form replaces the demo box. Card numbers go straight to the processor and never touch the website, which keeps PCI DSS scope to the simplest level (SAQ A).'],
  ['A small server step', 'A server function holds the processor’s secret key, confirms each payment (including 3-D Secure where the bank supports it), records the order and alerts the branch.'],
  ['Real prices, stock and policies', 'Prices and stock from Universal Hardware, plus the refund, returns, delivery, privacy and terms pages that processors require.'],
];
const approvals = [
  'Taking card payments: the merchant account, processor, prices, stock and customer policies.',
  'All branch hours, phone and WhatsApp numbers, addresses and email routing.',
  'Which brands are current lines, and how each relationship may be described (including any exclusivity).',
  'Category structure, product types and any product photography or logos.',
  'Use of the Universal Hardware name and wordmark, and a high-resolution logo file.',
  'Use of manufacturer logos and product photos, ideally replaced with high-resolution approved files.',
  'Bilingual service commitments before any Spanish content goes live.',
  'Service scope by brand, and parts ordering process.',
];
const roadmap = [
  { t: 'Online ordering & card payments', d: 'Switch the demo card step to Universal Hardware’s own processor once its merchant account is approved, with real prices and stock.' },
  { t: 'Catalogue & content management', d: 'Staff-editable categories, products, photos and promotions.' },
  { t: 'Inventory & pricing feed', d: 'Optional connection to the existing stock or POS system, if approved.' },
  { t: 'Enquiry routing', d: 'Send enquiries to the right branch team by WhatsApp or email, with consent.' },
  { t: 'AI Employee', d: 'An approved assistant trained on company-verified knowledge, with hand-off to staff.' },
  { t: 'Reporting', d: 'Privacy-respecting insight into what customers search for and ask about.' },
];
---
<Base
  title="About this concept"
  description="Independent website concept prepared by Austere Automations for presentation purposes. Not affiliated with or endorsed by Universal Hardware."
  section="concept"
>
  <PageHero
    eyebrow="Concept notes"
    title="An independent website concept."
    crumbs={[{ label: 'Concept' }]}
    dark
  >
    <p class="concept-statement">{SITE.conceptStatement}</p>
    <p class="concept-meta mono">Prepared by Austere Automations · {SITE.demoDate} · Public sources viewed {SOURCE_VIEWED}</p>
    <div class="concept-ctas">
      <a class="btn btn--light" href={SITE.officialUrl} target="_blank" rel="noopener">
        Visit Universal Hardware's current official website <Icon name="external" size={16} />
      </a>
    </div>
  </PageHero>

  <section class="section section--tight">
    <div class="container concept-grid">
      <div>
        <h2 class="h3">What works in this demonstration</h2>
        <ul class="concept-list">
          {works.map(([t, d]) => <li><Icon name="check" size={18} /><div><strong>{t}</strong><p>{d}</p></div></li>)}
        </ul>
      </div>
      <div>
        <h2 class="h3">What is illustrative</h2>
        <ul class="concept-list concept-list--plain">
          {illustrative.map((d) => <li><Icon name="info" size={18} /><p>{d}</p></li>)}
        </ul>
        <h2 class="h3 concept-h">What it never does</h2>
        <p class="concept-p">
          It takes no payments and sends no orders or quotes. The checkout’s card step is a demo stand-in that collects no card details. It
          shows no stock levels, warranties, delivery or returns terms, reviews or testimonials, and no prices other than the past sale prices in the
          Shop. Product and branch details must be confirmed with Universal Hardware.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight" id="shop">
    <div class="container">
      <h2 class="h2">How card payments would work</h2>
      <p class="concept-p">
        The Shop is a working cart and checkout. Only the last step is simulated: the card form is a stand-in and the processor’s answer is
        simulated, so nothing is charged. The checkout talks to card processors through one small interface, so the processor Universal Hardware
        chooses can be connected without redesigning it. Going live takes four things:
      </p>
      <ol class="pay-steps">
        {payments.map(([t, d], i) => <li><span class="roadmap__n mono">{String(i + 1).padStart(2, '0')}</span><div><strong>{t}</strong><p>{d}</p></div></li>)}
      </ol>
      <p class="concept-p">
        <a class="link-arrow" href="/shop/">Try the Shop <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <section class="section section--mist section--tight" id="privacy">
    <div class="container">
      <h2 class="h2">Data handling</h2>
      <div class="privacy-grid">
        {privacy.map(([t, d]) => <div class="privacy-card"><h3>{t}</h3><p>{d}</p></div>)}
      </div>
      <p class="concept-p concept-ai">
        <strong>About the Product Guide:</strong> it is a deterministic, rule-based guide built on public website information. No AI model is
        connected. The panel is built so an approved AI Employee can plug in later through the same interface, with its scope, limits and data sources
        disclosed to visitors.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container concept-grid">
      <div>
        <h2 class="h3">Needs Universal Hardware's approval before any launch</h2>
        <ul class="concept-list concept-list--plain">
          {approvals.map((d) => <li><Icon name="clipboard" size={18} /><p>{d}</p></li>)}
        </ul>
      </div>
      <div>
        <h2 class="h3">A possible production pathway</h2>
        <p class="concept-p">Shown as a future architecture only. Scope would be agreed with management first.</p>
        <ol class="roadmap">
          {roadmap.map((r, i) => <li><span class="roadmap__n mono">{String(i + 1).padStart(2, '0')}</span><div><strong>{r.t}</strong><p>{r.d}</p></div></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--mist section--tight">
    <div class="container credits">
      <h2 class="h3">Credits &amp; licences</h2>
      <ul>
        <li><strong>Universal Hardware wordmark:</strong> supplied reference image, displayed unaltered on light backgrounds. Belongs to Universal Hardware Company Ltd.</li>
        <li><strong>3D drill kit:</strong> built for this concept with Three.js (MIT) from the Makita 12V kit photo in Universal Hardware’s 2026 promotion. The photo’s outline is inflated into a 3D shape and the photo is mapped onto it. No third-party 3D model is used. Makita is a trademark of Makita Corporation.</li>
        <li><strong>Icons:</strong> original concept artwork.</li>
        <li><strong>Map outline:</strong> Natural Earth 1:10m country boundaries (public domain).</li>
        <li><strong>Typefaces:</strong> Archivo, Inter and JetBrains Mono (SIL Open Font License), self-hosted.</li>
        <li><strong>Product photos &amp; brand logos:</strong> taken from Universal Hardware's current website (universalhardware.bz) for this private concept. They belong to Universal Hardware and the respective manufacturers. Main product photos are cropped from 2026 News / Promotions graphics to the product alone, leaving out every price, date and sale message. Other photos are shown as published, with WebP copies added.</li>
        <li><strong>Homepage slideshow:</strong> concept images supplied by Austere Automations for this presentation, resized and re-encoded only. The Universal Hardware wordmark, the Lifan badge and the True Value signage shown in them belong to their owners.</li>
        <li><strong>Shop photos:</strong> cut out of the single-product graphics of Universal Hardware’s February 2026 Friends &amp; Family Sale, leaving out the printed price, dates and contact details. The model, description and price shown beside each photo are copied from the same graphic.</li>
        <li><strong>Brand names and logos</strong> are shown for identification and belong to their owners.</li>
      </ul>
      <p class="hint">See also: <a href="/about/#sources">full list of sources</a>.</p>
    </div>
  </section>
</Base>

<style>
  .concept-statement {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.5rem);
    line-height: 1.5;
    color: #fff;
    max-width: 50ch;
  }
  .concept-meta {
    color: var(--on-dark-muted);
  }
  .concept-ctas {
    margin-top: 6px;
  }
  .concept-ctas .btn {
    white-space: normal;
  }
  .concept-grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 960px) {
    .concept-grid {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }
  .concept-list {
    list-style: none;
    display: grid;
    gap: 12px;
    margin-top: 18px;
  }
  .concept-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .concept-list :global(svg) {
    color: var(--blue-600);
    margin-top: 2px;
  }
  .concept-list p {
    color: var(--steel);
    font-size: 0.92rem;
  }
  .concept-list--plain li {
    border: 0;
    background: var(--mist);
  }
  .concept-list--plain p {
    color: var(--ink);
  }
  .concept-h {
    margin-top: 32px;
  }
  .concept-p {
    margin-top: 12px;
    color: var(--steel);
    max-width: 62ch;
  }
  .privacy-grid {
    display: grid;
    gap: 14px;
    margin-top: 24px;
  }
  @media (min-width: 760px) {
    .privacy-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .privacy-card {
    padding: 20px;
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .privacy-card h3 {
    font-size: 1.05rem;
  }
  .privacy-card p {
    margin-top: 8px;
    font-size: 0.9rem;
    color: var(--steel);
  }
  .concept-ai {
    margin-top: 24px;
    color: var(--ink);
  }
  .roadmap {
    list-style: none;
    display: grid;
    gap: 0;
    margin-top: 18px;
    border-left: 2px solid var(--blue-100);
  }
  .roadmap li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    padding: 12px 0 12px 20px;
  }
  .roadmap li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 18px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--blue-600);
  }
  .roadmap__n {
    color: var(--blue-600);
    padding-top: 2px;
  }
  .roadmap p {
    color: var(--steel);
    font-size: 0.9rem;
  }
  .pay-steps {
    list-style: none;
    display: grid;
    gap: 14px;
    margin-top: 24px;
  }
  @media (min-width: 900px) {
    .pay-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .pay-steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    padding: 18px 20px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .pay-steps p {
    margin-top: 6px;
    color: var(--steel);
    font-size: 0.92rem;
  }
  .credits ul {
    display: grid;
    gap: 10px;
    margin: 16px 0;
    padding-left: 18px;
    font-size: 0.92rem;
  }
</style>
