---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [featured, ...rest] = posts;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Blog"
  description="The Duke Marine blog, guides, new arrivals and seasonal advice from Belize’s marine, fishing & diving supply shop."
>
  <PageHero
    eyebrow="Blog"
    title="From the shop &amp; the water"
    lead="Seasonal guides, new arrivals and advice from the Duke Marine team."
    crumbs={[{ label: 'Blog' }]}
  />

  <section class="section">
    <div class="container">
      {
        featured && (
          <a href={`/blog/${featured.id}`} class="feat" data-reveal>
            <div class="feat__media">
              <Media seed={featured.data.seed || featured.id} icon="waves" ratio="16 / 10" tone="current" label={featured.data.category} />
            </div>
            <div class="feat__body">
              <span class="post__meta">
                <span class="post__cat">{featured.data.category}</span>
                <span>{fmt(featured.data.date)}</span>
              </span>
              <h2>{featured.data.title}</h2>
              <p>{featured.data.excerpt}</p>
              <span class="link-arrow">Read article <Icon name="arrow" size={18} /></span>
            </div>
          </a>
        )
      }

      {
        rest.length > 0 && (
          <div class="posts">
            {rest.map((post, i) => (
              <a href={`/blog/${post.id}`} class="post" data-reveal data-reveal-delay={(i % 3) * 70}>
                <div class="post__media">
                  <Media seed={post.data.seed || post.id} icon="waves" ratio="16 / 9" pattern="topo" />
                </div>
                <div class="post__body">
                  <span class="post__meta">
                    <span class="post__cat">{post.data.category}</span>
                    <span>{fmt(post.data.date)}</span>
                  </span>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.excerpt}</p>
                  <span class="link-arrow">Read more <Icon name="arrow" size={16} /></span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <CtaBanner title="Questions about gear or a special order?" text="Our team is happy to help you spec the right setup for the season." />
</BaseLayout>

<style>
  .feat {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: 1.4rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    margin-bottom: 3rem;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
  }
  .feat:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }
  .feat__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .feat__body h2 {
    margin: 0.7rem 0 0.7rem;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
  }
  .feat__body p {
    color: var(--text-soft);
    margin-bottom: 1.2rem;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.6rem;
  }
  .post {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
  }
  .post:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .post__media {
    overflow: hidden;
  }
  .post__media :global(.media) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .post:hover .post__media :global(.media) {
    transform: scale(1.05);
  }
  .post__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    flex: 1;
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.78rem;
    color: var(--text-soft);
  }
  .post__cat {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-strong);
    font-weight: 600;
  }
  .post__body h3 {
    font-size: 1.15rem;
  }
  .post__body p {
    color: var(--text-soft);
    font-size: 0.9rem;
    flex: 1;
  }
  @media (max-width: 760px) {
    .feat {
      grid-template-columns: 1fr;
    }
  }
</style>
