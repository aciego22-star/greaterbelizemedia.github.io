---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import sharp from 'sharp';
import { fileURLToPath } from 'node:url';

/** Intrinsic size of a picture in public/, read at build time, so a card can
 *  reserve the right space for a photograph it is going to show whole. */
async function intrinsicSize(publicPath: string) {
  try {
    const file = fileURLToPath(new URL(`../../../public${publicPath}`, import.meta.url));
    const { width, height } = await sharp(file).metadata();
    return width && height ? { width, height } : null;
  } catch {
    return null;
  }
}

// Pinned articles hold the top of the list, then everything else newest
// first. Without this a notice that still matters is pushed down by the
// next thing published, however routine that happens to be.
const posts = (await getCollection('news')).sort(
  (a, b) =>
    Number(b.data.pinned) - Number(a.data.pinned) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
const [featured, ...rest] = posts;

const cardSrc = (p: { data: Record<string, any> }) =>
  p.data.cardImage ?? p.data.image ?? '/media/life/kingfish-lift.jpg';
const sizes = new Map<string, { width: number; height: number } | null>();
for (const p of posts) {
  const src = cardSrc(p);
  if (!sizes.has(src)) sizes.set(src, await intrinsicSize(src));
}


const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// One trail, given to both the visible breadcrumbs and the structured
// data, so the two can never describe different things.
const crumbs = [{ label: 'Blog' }];
---

<BaseLayout
  breadcrumbs={crumbs}
  title="Blog"
  description="The Duke Marine blog, guides, new arrivals and seasonal advice from Belize’s marine, fishing & diving supply shop."
>
  <PageHero
    eyebrow="Blog"
    title="From the shop &amp; the water"
    lead="Seasonal guides, new arrivals and advice from the Duke Marine team."
    crumbs={crumbs}
    image="/media/life/wahoo-catch.jpg"
    imageAlt="An angler holding a wahoo on a Belize fishing charter"
    imagePosition="center 40%"
  />

  <section class="section">
    <div class="container">
      {
        featured && (
          <a href={`/blog/${featured.id}`} class="feat" data-reveal>
            <div class="feat__media">
              <img
                src={featured.data.cardImage ?? featured.data.image ?? "/media/life/kingfish-lift.jpg"}
                alt={(featured.data.cardImage ? featured.data.cardImageAlt : undefined) ?? featured.data.imageAlt ?? "An angler holding a kingfish on a Belize fishing trip"}
                class="feat__img"
                width={sizes.get(cardSrc(featured))?.width}
                height={sizes.get(cardSrc(featured))?.height}
                loading="lazy"
              />
            </div>
            <div class="feat__body">
              <span class="post__meta">
                <span class="post__cat">{featured.data.category}</span>
                {featured.data.pinned && (
                  <span class="post__pinned">
                    <Icon name="anchor" size={13} /> Pinned
                  </span>
                )}
                <span>{fmt(featured.data.date)}</span>
              </span>
              <h2>{featured.data.title}</h2>
              <p>{featured.data.excerpt}</p>
              <span class="link-arrow">Read article <Icon name="arrow" size={18} /></span>
            </div>
          </a>
        )
      }

      {
        rest.length > 0 && (
          <div class:list={["posts", { "posts--few": rest.length < 3 }]}>
            {rest.map((post, i) => (
              <a href={`/blog/${post.id}`} class="post" data-reveal data-reveal-delay={(i % 3) * 70}>
                <div class="post__media">
                  {post.data.cardImage || post.data.image ? (
                    <img
                      src={post.data.cardImage ?? post.data.image}
                      alt={(post.data.cardImage ? post.data.cardImageAlt : undefined) ?? post.data.imageAlt ?? ""}
                      class="post__img"
                      width={sizes.get(cardSrc(post))?.width}
                      height={sizes.get(cardSrc(post))?.height}
                      loading="lazy"
                    />
                  ) : (
                    <Media seed={post.data.seed || post.id} icon="waves" ratio="16 / 9" pattern="topo" />
                  )}
                </div>
                <div class="post__body">
                  <span class="post__meta">
                    <span class="post__cat">{post.data.category}</span>
                    <span>{fmt(post.data.date)}</span>
                  </span>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.excerpt}</p>
                  <span class="link-arrow">Read more <Icon name="arrow" size={16} /></span>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <CtaBanner title="Questions about gear?" text="Our team is happy to help you find the right setup for the season." />
</BaseLayout>

<style>
  .feat {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: 1.4rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    margin-bottom: 3rem;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
  }
  @media (hover: hover) and (pointer: fine) {
  .feat:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }
}
  .feat__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  /* Shown whole, not cropped to a landscape box. Four of the five covers are
     upright, and 16/10 cut the top off a person standing in frame. Centred at
     its own proportions and capped in height, so nothing is sliced and there
     are no filler bars either side. */
  .feat__img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 60svh;
    margin-inline: auto;
    border-radius: inherit;
  }
  .feat__body h2 {
    margin: 0.7rem 0 0.7rem;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
  }
  .feat__body p {
    color: var(--text-soft);
    margin-bottom: 1.2rem;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.6rem;
  }
  /* With only one or two articles beside the featured one, a full-width track
     leaves a lone card stranded at a third of the row. Cap the card width and
     centre the group so the section stays balanced until the grid fills out. */
  .posts--few {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 460px));
    justify-content: center;
  }
  .post {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
  }
  @media (hover: hover) and (pointer: fine) {
  .post:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
}
  .post__img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 340px;
    margin-inline: auto;
  }
  .post__media {
    overflow: hidden;
  }
  .post__media :global(.media) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
  .post:hover .post__media :global(.media) {
    transform: scale(1.05);
  }
}
  .post__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    flex: 1;
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.78rem;
    color: var(--text-soft);
  }
  .post__cat {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-strong);
    font-weight: 600;
  }
  /* Marks the article held at the top of the list, so an older post sitting
     above a newer one reads as deliberate rather than as a broken sort. */
  .post__pinned {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--gold) 16%, transparent);
    color: var(--gold);
    font-weight: 600;
  }
  .post__pinned :global(svg) {
    flex: none;
  }
  .post__body h3 {
    font-size: 1.15rem;
  }
  .post__body p {
    color: var(--text-soft);
    font-size: 0.9rem;
    flex: 1;
  }
  @media (max-width: 760px) {
    .feat {
      grid-template-columns: 1fr;
    }
  }
</style>
