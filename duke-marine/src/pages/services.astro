---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import Reveal from '../components/Reveal.astro';
import CtaBanner from '../components/CtaBanner.astro';

const services = [
  {
    icon: 'compass',
    title: 'Product guidance',
    text: 'Not sure what you need? Tell us about your boat, gear or project and we’ll help you find the right marine, fishing or diving product.',
    points: ['Marine, fishing & diving', 'Honest recommendations', 'By phone, email or in store'],
  },
  {
    icon: 'mail',
    title: 'Product enquiries',
    text: 'Ask about stock, availability or product details before you visit or place an order.',
    points: ['Stock & availability', 'Product details', 'Quick replies'],
  },
  {
    icon: 'tag',
    title: 'Quotations',
    text: 'Tell us the product, brand or model and we’ll put together a quote by email or WhatsApp.',
    points: ['By email or WhatsApp', 'Product, brand or model', 'No obligation'],
  },
  {
    icon: 'truck',
    title: 'Special orders',
    text: 'If it’s not on the shelf, we can help source it. Tell us the make and model and we’ll look into availability.',
    points: ['Parts & gear sourcing', 'Brand requests', 'Availability check'],
  },
  {
    icon: 'whatsapp',
    title: 'WhatsApp assistance',
    text: 'Message Duke Marine on WhatsApp with a product name, model or photo and we’ll help you find it.',
    points: ['Send a photo', 'Ask a question', 'Fast response'],
  },
  {
    icon: 'pin',
    title: 'In-store shopping',
    text: 'Visit the shop on the Philip Goldson Highway to browse marine, fishing and diving supplies in person.',
    points: ['Browse in person', 'Mile 4½, Belize City', 'Marine · Fishing · Diving'],
  },
];

const steps = [
  { n: '01', title: 'Tell us what you need', text: 'Call, message or drop in with the product, part or gear you’re after.' },
  { n: '02', title: 'We check & quote', text: 'We confirm availability and give you clear pricing by email or WhatsApp.' },
  { n: '03', title: 'We source it if needed', text: 'If it’s not in stock, we look into sourcing it through our suppliers.' },
  { n: '04', title: 'Pick it up', text: 'Collect it in store, ready to go, and we’re here for anything you need after.' },
];
---

<BaseLayout
  title="Services"
  description="Duke Marine offers product guidance, enquiries, quotations, special orders and WhatsApp assistance for marine, fishing and diving supplies in Belize City."
>
  <PageHero
    eyebrow="Services"
    title="How Duke Marine helps"
    lead="From product guidance to quotes and special orders, here’s how we help you find the right marine, fishing and diving gear."
    crumbs={[{ label: 'Services' }]}
  />

  <!-- Services grid -->
  <section class="section">
    <div class="container">
      <div class="svc">
        {
          services.map((s, i) => (
            <Reveal class="svc__card" delay={(i % 3) * 80}>
              <span class="svc__icon"><Icon name={s.icon} size={26} /></span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <ul role="list" class="svc__points">
                {s.points.map((p) => <li><Icon name="check" size={15} /> {p}</li>)}
              </ul>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section on-dark" style="background: var(--grad-deep)">
    <div class="container">
      <SectionHeader eyebrow="How it works" title="Simple, from enquiry to on the water" align="center" />
      <div class="steps">
        {
          steps.map((s, i) => (
            <Reveal class="step" delay={i * 80}>
              <span class="step__n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner title="Need help finding a part?" text="Tell us the product, brand or model and we’ll help you find it, by email, WhatsApp or in store." />
</BaseLayout>

<style>
  .svc {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  .svc__card {
    padding: 1.8rem 1.6rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur), border-color var(--dur);
  }
  .svc__card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .svc__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 15px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent-strong);
    margin-bottom: 1rem;
    transition: transform var(--dur), background var(--dur), color var(--dur);
  }
  .svc__card:hover .svc__icon {
    transform: rotate(-6deg);
    background: var(--accent);
    color: #fff;
  }
  .svc__card h3 {
    font-size: 1.2rem;
  }
  .svc__card > p {
    margin-top: 0.5rem;
    color: var(--text-soft);
    font-size: 0.92rem;
  }
  .svc__points {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .svc__points li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .svc__points :global(svg) {
    color: var(--accent-strong);
    flex: none;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.3rem;
    counter-reset: step;
  }
  .step {
    position: relative;
    padding: 1.7rem 1.4rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .step__n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
    background: var(--grad-current);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .step h3 {
    margin-top: 0.6rem;
    font-size: 1.1rem;
  }
  .step p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    color: var(--text-soft);
  }

  @media (max-width: 860px) {
    .svc {
      grid-template-columns: 1fr 1fr;
    }
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .svc {
      grid-template-columns: 1fr;
    }
  }
</style>
