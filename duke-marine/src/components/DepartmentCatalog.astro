---
import PageHero from './PageHero.astro';
import CategoryCard from './CategoryCard.astro';
import ProductCard from './ProductCard.astro';
import Media from './Media.astro';
import Icon from './Icon.astro';
import CtaBanner from './CtaBanner.astro';
import { departments, type DepartmentId } from '../data/catalog';
import { productsByDepartment } from '../data/products';

interface Props {
  dept: DepartmentId;
}
const { dept } = Astro.props;
const d = departments[dept];
const items = productsByDepartment(dept);
const others = (Object.keys(departments) as DepartmentId[])
  .filter((id) => id !== dept)
  .map((id) => departments[id]);

const iconFor: Record<DepartmentId, string> = {
  marine: 'boat',
  fishing: 'fish',
  diving: 'compass',
};
const toneFor: Record<DepartmentId, 'current' | 'brass' | 'deep'> = {
  marine: 'current',
  fishing: 'brass',
  diving: 'deep',
};

// group products by category id for anchored sections
const byCategory = d.categories.map((c) => ({
  category: c,
  products: items.filter((p) => p.category === c.id),
}));
---

<PageHero
  eyebrow="Shop the range"
  title={d.title}
  lead={d.tagline}
  crumbs={[{ label: d.title }]}
>
  <div class="dhero__actions" data-reveal data-reveal-delay="180">
    <a href="#categories" class="btn btn--gold">Browse categories <Icon name="arrow" size={18} /></a>
    <a href="/contact#quote" class="btn btn--ghost">Request a quote</a>
  </div>
</PageHero>

<!-- Categories -->
<section id="categories" class="section">
  <div class="container">
    <div class="grid auto-fit" style="--min: 260px">
      {d.categories.map((c, i) => <CategoryCard category={c} href={`#${c.id}`} delay={i * 60} />)}
    </div>
  </div>
</section>

<!-- Product listing grouped by category (anchored) -->
<section class="section section-tight" style="background: var(--bg-inset)">
  <div class="container">
    {
      byCategory.map(({ category, products }) => (
        <div class="catgroup" id={category.id}>
          <div class="catgroup__head" data-reveal>
            <div>
              <span class="eyebrow"><Icon name={category.icon} size={16} /> {category.name}</span>
              <p class="catgroup__blurb">{category.blurb}</p>
            </div>
            <a href="/contact#quote" class="btn btn--ghost btn--sm">Ask about {category.name.split(' ')[0].toLowerCase()} <Icon name="arrow" size={15} /></a>
          </div>
          {products.length > 0 ? (
            <div class="grid auto-fit" style="--min: 250px">
              {products.map((p, i) => <ProductCard product={p} delay={(i % 4) * 60} />)}
            </div>
          ) : (
            <div class="catgroup__empty" data-reveal>
              <p><b>In stock &amp; special order.</b> We carry a full range of {category.name.toLowerCase()} — including {category.examples.slice(0, 3).join(', ')} and more.</p>
              <a href="/contact#quote" class="link-arrow">Ask us what’s available <Icon name="arrow" size={16} /></a>
            </div>
          )}
        </div>
      ))
    }

    <p class="catnote" data-reveal>
      <Icon name="tag" size={18} /> Don’t see it? We special-order from our full range —
      <a href="/contact">just ask</a>.
    </p>
  </div>
</section>

<!-- Cross-sell to the other departments -->
<section class="section">
  <div class="container">
    <span class="eyebrow crossell__eyebrow" data-reveal>Also at Duke Marine</span>
    <div class="crossell-grid">
      {
        others.map((o, i) => (
          <a href={o.href} class="crossell" data-reveal data-reveal-delay={i * 90}>
            <div class="crossell__media">
              <Media seed={o.id} icon={iconFor[o.id]} ratio="16 / 10" tone={toneFor[o.id]} />
            </div>
            <div class="crossell__body">
              <h3>{o.title}</h3>
              <p>{o.tagline}</p>
              <span class="link-arrow">Explore <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<CtaBanner />

<style>
  .dhero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .catgroup {
    scroll-margin-top: 100px;
    padding-block: clamp(1.8rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border);
  }
  .catgroup:last-of-type {
    border-bottom: 0;
  }
  .catgroup__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }
  .catgroup__blurb {
    margin-top: 0.6rem;
    max-width: 60ch;
    color: var(--text-soft);
  }
  .catgroup__empty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1.6rem 1.8rem;
    background: var(--bg-elevated);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }
  .catgroup__empty p {
    color: var(--text-soft);
    max-width: 62ch;
  }
  .catnote {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 2.5rem;
    color: var(--text-soft);
  }
  .catnote a {
    color: var(--accent-strong);
    font-weight: 600;
  }
  .catnote :global(svg) {
    color: var(--accent-strong);
  }

  .crossell__eyebrow {
    display: block;
    margin-bottom: 1.4rem;
  }
  .crossell-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
  }
  .crossell {
    display: flex;
    flex-direction: column;
    background: var(--grad-deep);
    color: var(--text-invert);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
  }
  .crossell:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .crossell__media {
    overflow: hidden;
  }
  .crossell__media :global(.media) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .crossell:hover .crossell__media :global(.media) {
    transform: scale(1.05);
  }
  .crossell__body {
    padding: 1.4rem 1.6rem 1.6rem;
  }
  .crossell__body h3 {
    font-size: 1.4rem;
  }
  .crossell__body p {
    margin: 0.4rem 0 1rem;
    color: #cfe4e6;
  }
  .crossell__body .link-arrow {
    color: var(--c-current-bright);
  }
  @media (max-width: 680px) {
    .crossell-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
