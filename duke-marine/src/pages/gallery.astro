---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import VideoSection from '../components/VideoSection.astro';
import Icon from '../components/Icon.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { galleryGroups, dayOnTheWaterVideos, galleryVideos } from '../data/gallery';
---

<BaseLayout
  title="Gallery & Video"
  description="Photos and video from Duke Marine, real fishing trips, boats, catches and the Belize coastline, plus gear on the shelves in Belize City."
>
  <PageHero
    eyebrow="Gallery & Video"
    title="Straight from the shop, and out on the water"
    lead="Real gear, real boats, real Belize. A look at the life behind Duke Marine, on the water and on the shelves."
    crumbs={[{ label: 'Gallery' }]}
  />

  <!-- A Day on the Water (featured video) -->
  <section class="section" id="a-day-on-the-water">
    <div class="container">
      <SectionHeader
        eyebrow="Watch"
        title="A Day on the Water"
        lead="Real trips off Belize City, boats leaving the dock, trolling the blue water and fish coming over the rail. Tap a clip to play."
      />
      <div class="vids vids--four">
        {
          dayOnTheWaterVideos.map((v) => (
            <VideoSection src={v.src} poster={v.poster} label={v.label} ratio={v.ratio} showLabel={true} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Themed photo galleries -->
  {
    galleryGroups.map((group, gi) => (
      <section class:list={['section', { 'section-tight': gi > 0 }]} style={gi % 2 === 1 ? 'background: var(--bg-inset)' : undefined}>
        <div class="container">
          <SectionHeader title={group.title} lead={group.blurb} />
          <div class="gal">
            {group.photos.map((p, i) => (
              <figure class="gal__cell" data-reveal data-reveal-delay={(i % 4) * 60}>
                <img src={p.src} alt={p.alt} loading="lazy" />
              </figure>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <!-- More from Duke Marine (social clips) -->
  <section class="section-tight" style="background: var(--bg-inset)">
    <div class="container">
      <SectionHeader
        eyebrow="More"
        title="More from Duke Marine"
        lead="Short clips from the shop and the crew. Drop us your own and we’ll feature them here."
      />
      <div class="vids">
        {
          galleryVideos.map((v) => (
            <VideoSection embed={v.embed} poster={v.poster} label={v.label} showLabel={false} ratio={v.ratio} />
          ))
        }
      </div>
      <p class="galnote" data-reveal>
        <Icon name="play" size={18} /> Have photos or video of your Duke Marine gear in action?
        <a href="/contact">Send them in</a> and we’ll add them to the gallery.
      </p>
    </div>
  </section>

  <CtaBanner title="Come see it in person" text="The shelves have a lot more than we can fit here, visit the shop or send us your list." />
</BaseLayout>

<style>
  .gal {
    column-count: 4;
    column-gap: 1rem;
  }
  .gal__cell {
    position: relative;
    margin: 0 0 1rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--c-navy);
    break-inside: avoid;
  }
  .gal__cell img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.8s var(--ease-out);
  }
  .gal__cell:hover img {
    transform: scale(1.06);
  }

  .vids {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .vids--four {
    grid-template-columns: repeat(4, 1fr);
    max-width: 1000px;
  }
  .galnote {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 2.2rem;
    color: var(--text-soft);
    flex-wrap: wrap;
  }
  .galnote a {
    color: var(--accent-strong);
    font-weight: 600;
  }
  .galnote :global(svg) {
    color: var(--accent-strong);
  }

  @media (max-width: 1080px) {
    .gal {
      column-count: 3;
    }
    .vids--four {
      grid-template-columns: repeat(3, 1fr);
      max-width: 760px;
    }
  }
  @media (max-width: 760px) {
    .gal {
      column-count: 2;
    }
    .vids--four {
      grid-template-columns: repeat(2, 1fr);
      max-width: 460px;
    }
  }
  @media (max-width: 560px) {
    .vids {
      grid-template-columns: 1fr;
      max-width: 320px;
    }
  }
  @media (max-width: 400px) {
    .gal {
      column-count: 1;
    }
  }
</style>
