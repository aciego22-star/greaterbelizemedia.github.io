---
interface Stat {
  value: number;
  suffix?: string;
  prefix?: string;
  decimals?: number;
  label: string;
}
interface Props {
  stats?: Stat[];
  class?: string;
}
const {
  stats = [
    { value: 1991, label: 'Serving Belize since' },
    { value: 1, suffix: 'st', label: 'Marine store in Belize' },
    { value: 3, label: 'Departments under one roof' },
    { value: 1, label: 'One-stop shop on the Highway' },
  ],
  class: cls = '',
} = Astro.props;
---

<div class:list={['stats', cls]}>
  {
    stats.map((s, i) => (
      <div class="stat" data-reveal data-reveal-delay={i * 90}>
        <div
          class="stat__value"
          data-count={s.value}
          data-suffix={s.suffix || ''}
          data-prefix={s.prefix || ''}
          data-decimals={s.decimals || 0}
        >
          {s.prefix || ''}
          {s.value}
          {s.suffix || ''}
        </div>
        <div class="stat__label">{s.label}</div>
      </div>
    ))
  }
</div>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .stat {
    padding: 1.6rem 1.4rem;
    text-align: center;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--c-navy) 4%, var(--bg-elevated));
    border: 1px solid var(--border);
  }
  .on-dark .stat {
    background: rgba(255, 255, 255, 0.04);
  }
  .stat__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    background: var(--grad-current);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat__label {
    margin-top: 0.6rem;
    font-size: 0.86rem;
    color: var(--text-soft);
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
