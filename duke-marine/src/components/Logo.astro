---
/**
 * Duke Marine brand lockup: the real anchor badge + wordmark.
 * The badge (public/media/logo.jpg) carries the brand; the wordmark keeps
 * the name crisp at small sizes and on any background.
 */
interface Props {
  class?: string;
  compact?: boolean;
}
const { class: cls = '', compact = false } = Astro.props;
---

<a href="/" class:list={['logo', cls]} aria-label="Duke Marine, home">
  <img
    src="/media/logo.jpg"
    alt="Duke Marine"
    class="logo__badge"
    width="46"
    height="46"
    loading="eager"
  />
  {
    !compact && (
      <span class="logo__type">
        <strong>DUKE&nbsp;MARINE</strong>
        <span class="logo__tag">Marine Parts · Sales · Service</span>
        <span class="logo__tag">Fishing · Diving · Boat Supplies</span>
      </span>
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: inherit;
    /* Never let the wordmark be squeezed narrower than its text, which used to
       make it spill over the first navigation item on mid-width screens. */
    flex: none;
  }
  .logo__badge {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
    transition: transform var(--dur) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
  .logo:hover .logo__badge {
    transform: rotate(-6deg) scale(1.04);
  }
}
  .logo__type {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.05;
    font-family: var(--font-display);
  }
  .logo__type strong {
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    color: var(--gold, #e6b83f);
    margin-bottom: 0.1rem;
  }
  .logo__tag {
    font-size: 0.53rem;
    font-weight: 600;
    color: #ffffff;
    opacity: 0.8;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* Decongest the header: keep the badge + wordmark, drop the taglines until
     the viewport is wide enough for them to sit beside the navigation without
     colliding with it. */
  @media (max-width: 1400px) {
    .logo {
      gap: 0.55rem;
    }
    .logo__type span {
      display: none;
    }
    .logo__type strong {
      font-size: 1.15rem;
      letter-spacing: 0.06em;
    }
  }
</style>
