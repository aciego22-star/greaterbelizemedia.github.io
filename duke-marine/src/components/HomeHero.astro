---
/**
 * Full-image hero slideshow — cross-fades the client's brand photos every 7s.
 * Each slide shows the WHOLE image (contain) in any orientation, over a blurred
 * fill of itself so there are no empty bars. Respects prefers-reduced-motion.
 * Swap/add images in public/media and edit the `slides` array below.
 */
const slides = [
  { src: '/media/hero-2.jpg', label: 'Fishing and diving gear from Duke Marine' },
  { src: '/media/hero-4.jpg', label: 'Below the surface, adventure has no limits' },
  { src: '/media/hero-1.jpg', label: 'Where the tide slows, the soul finds its way' },
  { src: '/media/hero-3.jpg', label: 'Duke Marine — for all your marine needs' },
];
---

<section class="hero on-dark">
  <h1 class="visually-hidden">Duke Marine — marine, fishing &amp; diving supplies in Belize City</h1>

  <div class="hero__slides" data-hero-slides aria-label="Duke Marine">
    {
      slides.map((s, i) => (
        <div class:list={['hero__slide', { 'is-active': i === 0 }]} role="img" aria-label={s.label}>
          <div class="hero__slide-blur" style={`background-image:url(${s.src})`}></div>
          <div class="hero__slide-img" style={`background-image:url(${s.src})`}></div>
        </div>
      ))
    }
  </div>
  <div class="hero__scrim"></div>

  <div class="container hero__inner">
    <div class="hero__dots" data-hero-dots role="tablist" aria-label="Choose slide">
      {slides.map((_, i) => (
        <button class:list={['hero__dot', { 'is-active': i === 0 }]} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: flex-end;
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--text-invert);
    overflow: hidden;
    background: var(--c-navy);
  }
  .hero__slides {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  /* blurred fill (no empty bars) */
  .hero__slide-blur {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(28px) brightness(0.55);
    transform: scale(1.12);
  }
  /* the full image, shown whole in any orientation */
  .hero__slide-img {
    position: absolute;
    inset: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }
  /* subtle top scrim so the (transparent) desktop nav stays legible */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(6, 22, 44, 0.65) 0%,
      rgba(6, 22, 44, 0.1) 22%,
      rgba(6, 22, 44, 0) 45%
    );
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .hero__dots {
    display: flex;
    gap: 0.6rem;
  }
  .hero__dot {
    width: 34px;
    height: 5px;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.45);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    padding: 0;
    transition: background 0.3s, width 0.3s;
  }
  .hero__dot.is-active {
    background: var(--gold);
    width: 46px;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 72svh;
      padding-top: calc(var(--header-h) + 3.6rem);
    }
    .hero__slide-blur {
      filter: blur(22px) brightness(0.55);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: opacity 0.01s;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-hero-slides]').forEach((wrap) => {
    const slides = [...wrap.querySelectorAll<HTMLElement>('.hero__slide')];
    const dots = [
      ...(wrap.parentElement?.querySelectorAll<HTMLButtonElement>('[data-hero-dots] .hero__dot') ?? []),
    ];
    if (slides.length < 2) return;
    let i = 0;
    let timer = 0;
    const go = (n: number) => {
      slides[i].classList.remove('is-active');
      dots[i]?.classList.remove('is-active');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('is-active');
      dots[i]?.classList.add('is-active');
    };
    const start = () => {
      if (reduce) return;
      stop();
      timer = window.setInterval(() => go(i + 1), 7000);
    };
    const stop = () => timer && window.clearInterval(timer);
    dots.forEach((d, n) =>
      d.addEventListener('click', () => {
        go(n);
        start();
      }),
    );
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  });
</script>
