---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import VideoSection from '../components/VideoSection.astro';
import Icon from '../components/Icon.astro';
import CtaBanner from '../components/CtaBanner.astro';

// Real photos supplied by the client. Add more to public/media and list here.
const photos = [
  { src: '/media/gallery-2.jpg', alt: 'Fishing, diving and marine gear at Duke Marine' },
  { src: '/media/gallery-6.jpg', alt: 'Marine paints and coatings, AwlGrip and Pettit, at Duke Marine' },
  { src: '/media/gallery-1.jpg', alt: 'Cast nets and gear on the shelves at Duke Marine' },
  { src: '/media/gallery-7.jpg', alt: 'Stainless boat hardware, locks and fittings at Duke Marine' },
  { src: '/media/gallery-10.jpg', alt: 'Paint prep, brushes, tape and sandpaper at Duke Marine' },
  { src: '/media/gallery-3.jpg', alt: 'Rope and rode on the reel inside the Duke Marine shop' },
  { src: '/media/gallery-9.jpg', alt: 'Bilge pumps and livewell pumps at Duke Marine' },
  { src: '/media/gallery-5.jpg', alt: 'For all your marine needs, Duke Marine, Belize City' },
  { src: '/media/gallery-8.jpg', alt: 'Navigation lights and marine electrical at Duke Marine' },
  { src: '/media/gallery-4.jpg', alt: 'Marine and fishing supplies stocked at Duke Marine' },
];

// Client YouTube Shorts, shown as click-to-play thumbnails (vertical 9:16).
const videos = [
  { id: 'BP_keqKlThg', label: 'Duke Marine' },
  { id: 'bIZUxUjjW00', label: 'Duke Marine' },
  { id: '6NAgBH6EkHc', label: 'Duke Marine' },
];
---

<BaseLayout
  title="Gallery & Video"
  description="Photos and video from Duke Marine, gear, boats and the crew in Belize City. Marine, fishing and diving supplies, sales and service."
>
  <PageHero
    eyebrow="Gallery & Video"
    title="Straight from the shop"
    lead="Real gear, real boats, real Belize. A look at what’s on the shelves and out on the water."
    crumbs={[{ label: 'Gallery' }]}
  />

  <!-- Photo gallery -->
  <section class="section">
    <div class="container">
      <div class="gal">
        {
          photos.map((p, i) => (
            <figure class="gal__cell" data-reveal data-reveal-delay={(i % 4) * 60}>
              <img src={p.src} alt={p.alt} loading="lazy" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section-tight" style="background: var(--bg-inset)">
    <div class="container">
      <SectionHeader
        eyebrow="Watch"
        title="Video from Duke Marine"
        lead="Product walk-throughs, brand stories and how-tos. Drop us your clips and we’ll feature them here."
      />
      <div class="vids">
        {
          videos.map((v) => (
            <VideoSection
              embed={`https://www.youtube.com/embed/${v.id}`}
              poster={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
              label={v.label}
              ratio="9 / 16"
            />
          ))
        }
      </div>
      <p class="galnote" data-reveal>
        <Icon name="play" size={18} /> Have photos or video of your Duke Marine gear in action?
        <a href="/contact">Send them in</a> and we’ll add them to the gallery.
      </p>
    </div>
  </section>

  <CtaBanner title="Come see it in person" text="The shelves have a lot more than we can fit here, visit the shop or send us your list." />
</BaseLayout>

<style>
  .gal {
    column-count: 4;
    column-gap: 1rem;
  }
  .gal__cell {
    position: relative;
    margin: 0 0 1rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--c-navy);
    break-inside: avoid;
  }
  .gal__cell img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.8s var(--ease-out);
  }
  .gal__cell:hover img {
    transform: scale(1.06);
  }

  .vids {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .galnote {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 2.2rem;
    color: var(--text-soft);
    flex-wrap: wrap;
  }
  .galnote a {
    color: var(--accent-strong);
    font-weight: 600;
  }
  .galnote :global(svg) {
    color: var(--accent-strong);
  }

  @media (max-width: 1080px) {
    .gal {
      column-count: 3;
    }
  }
  @media (max-width: 760px) {
    .gal {
      column-count: 2;
    }
  }
  @media (max-width: 560px) {
    .vids {
      grid-template-columns: 1fr;
      max-width: 320px;
    }
  }
  @media (max-width: 400px) {
    .gal {
      column-count: 1;
    }
  }
</style>
