<?xml version="1.0" encoding="UTF-8"?>
<!-- A placeholder, and not the one that gets deployed.

     The real sitemap is written by build/build-static.js, which lists
     every route in both languages with its language pair, and which
     takes the host from the one setting at the top of that file. It
     overwrites this file in dist/site.

     This copy exists so the source directory is servable on its own and
     so a crawler probing /sitemap.xml never gets a 404. One entry,
     because without the build the source really is a single page: every
     route is a hash off the home page, and a crawler cannot treat a
     fragment as a URL. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://www.icbinsurance.com/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
