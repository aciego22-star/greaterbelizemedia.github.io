---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES } from '../data/categories';

const news = [
  { title: 'Universal Mega Sale 2026', date: 'Apr 23, 2026', href: 'https://universalhardware.bz/news/2026/04/universal-mega-sale-2026/' },
  { title: 'Spanish Lookout Commercial Industrial Expo 2026', date: 'Mar 5, 2026', href: 'https://universalhardware.bz/news/2026/03/spanish-lookout-commercial-industrial-expo-2026/' },
  { title: 'Friends And Family Day 2026', date: 'Jan 26, 2026', href: 'https://universalhardware.bz/news/2026/01/friends-and-family-day-2026/' },
];
const facts = [
  { k: 'What it does', v: 'Retail and wholesale distribution of hardware tools, household appliances, power equipment, motorcycles and welding supplies.', src: 'home' },
  { k: 'Where', v: 'Two branches: Spanish Lookout (main branch) in Cayo District, and Belize City.', src: 'about' },
  { k: 'Range', v: `${CATEGORIES.length} product categories, from power tools and welding supplies to Meilun and Lifan motorcycles.`, src: 'productListing' },
  { k: 'Brands', v: 'Makers across tools, outdoor power, lighting, appliances and fencing. Universal Hardware is a member of the True Value cooperative.', src: 'brands' },
  { k: 'Service', v: 'A Service Center WhatsApp line at each branch, and Meilun parts catalogues for parts orders.', src: 'about' },
] as const;
---
<Base
  title="About"
  description="About Universal Hardware Company Ltd.: retail and wholesale distributor of hardware tools, household appliances, power equipment, motorcycles and welding supplies in Belize."
  section="about"
>
  <PageHero
    eyebrow="About Universal Hardware"
    title="Tools, equipment and home essentials for Belize."
    lead="Universal Hardware Company Ltd. is a retail and wholesale distributor, serving customers from branches in Spanish Lookout and Belize City."
    crumbs={[{ label: 'About' }]}
  />

  <section class="section section--tight">
    <div class="container about-grid">
      <div class="about-main">
        <p class="about-intro">
          From power tools and welding supplies to generators, water pumps, lawn equipment, motorcycles, household appliances and farm hardware, the
          range covers work, home and industry.
        </p>
        <dl class="fact-list">
          {
            facts.map((f) => (
              <div class="fact" data-reveal>
                <dt class="mono">{f.k}</dt>
                <dd>
                  <p>{f.v}</p>
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="about-news">
          <h2 class="h3">Recent news &amp; promotions</h2>
          <ul>
            {
              news.map((n) => (
                <li>
                  <a href={n.href} target="_blank" rel="noopener">
                    <span class="about-news__date mono">{n.date}</span>
                    <span class="about-news__title">{n.title}</span>
                    <Icon name="external" size={16} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="about-aside">
        <div class="about-aside__card">
          <p class="eyebrow eyebrow--plain">Visit a branch</p>
          <p>Spanish Lookout and Belize City, with sales and service lines at both.</p>
          <a class="btn btn--block" href="/locations/">Locations &amp; hours <Icon name="arrow-right" size={16} /></a>
        </div>
        <div class="about-aside__card about-aside__card--quiet">
          <p class="eyebrow eyebrow--plain">Shop online</p>
          <p>Order Makita tools and Lifan and Meilun motorcycles online, then collect at the branch.</p>
          <a class="btn btn--ghost btn--block" href="/shop/">Go to the Shop <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  .about-grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1000px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 64px;
      align-items: start;
    }
  }
  .about-main {
    display: grid;
    gap: 40px;
  }
  .about-intro {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    line-height: 1.5;
    max-width: 52ch;
  }
  .fact-list {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .fact {
    display: grid;
    gap: 8px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 700px) {
    .fact {
      grid-template-columns: 180px 1fr;
      gap: 24px;
    }
  }
  .fact dt {
    color: var(--blue-600);
    padding-top: 3px;
  }
  .fact dd {
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .fact dd p {
    font-size: 1.05rem;
  }
  .about-news ul {
    list-style: none;
    display: grid;
    gap: 10px;
    margin: 16px 0 12px;
  }
  .about-news a {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 16px;
    align-items: center;
    min-height: 60px;
    padding: 14px 18px;
    border-radius: 14px;
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur), background-color var(--dur);
  }
  .about-news a:hover {
    border-color: var(--blue-600);
    background: var(--blue-50);
  }
  .about-news__date {
    color: var(--steel);
  }
  .about-news__title {
    font-weight: 650;
  }
  @media (max-width: 520px) {
    .about-news a {
      grid-template-columns: 1fr auto;
    }
    .about-news__date {
      grid-column: 1 / -1;
    }
  }
  .about-aside {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 1000px) {
    .about-aside {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .about-aside__card {
    display: grid;
    gap: 12px;
    padding: 22px;
    border-radius: var(--radius-lg);
    background: var(--graphite);
    color: var(--on-dark);
  }
  .about-aside__card .eyebrow {
    color: var(--blue-on-dark);
  }
  .about-aside__card--quiet {
    background: var(--mist);
    color: var(--ink);
  }
  .about-aside__card--quiet .eyebrow {
    color: var(--blue-600);
  }
</style>
