---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<footer class="footer on-dark">
  <svg class="divider-wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M0 30c120 20 240 30 360 25s240-25 360-25 240 20 360 20 240-15 360-20v40H0Z"
      fill="var(--c-navy)"></path>
  </svg>

  <div class="footer__top container container-wide">
    <div class="footer__brand">
      <Logo />
      <p class="footer__mission">
        {site.description}
      </p>
      <div class="footer__social">
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="social social--fb"><Icon name="facebook" size={20} /></a>
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="social social--ig"><Icon name="instagram" size={20} /></a>
        {site.social.youtube && (
          <a href={site.social.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="social social--yt"><Icon name="youtube" size={20} /></a>
        )}
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp" class="social social--wa"><Icon name="whatsapp" size={20} /></a>
      </div>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <div>
        <h3 class="footer__heading">Explore</h3>
        <ul role="list">
          <li><a href="/">Home</a></li>
          <li><a href="/marine-supplies">Marine Supplies</a></li>
          <li><a href="/fishing-supplies">Fishing Supplies</a></li>
          <li><a href="/diving-supplies">Diving Supplies</a></li>
          <li><a href="/brands">Brands</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/services">Services</a></li>
        </ul>
      </div>
      <div>
        <h3 class="footer__heading">Company</h3>
        <ul role="list">
          <li><a href="/about">About Us</a></li>
          <li><a href="/gallery">Gallery &amp; Video</a></li>
          <li><a href="/careers">Careers</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer__contact">
        <h3 class="footer__heading">Visit &amp; Contact</h3>
        <ul role="list">
          <li>
            <Icon name="pin" size={18} />
            <span>{site.address.line1}, {site.address.city}, {site.address.country}</span>
          </li>
          <li>
            <Icon name="phone" size={18} />
            <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
          </li>
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Icon name="clock" size={18} />
            <span class="footer__hours">
              {site.hours.map((h) => (
                <span class="footer__hourline">{h.day}: {h.time}</span>
              ))}
            </span>
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="footer__bottom container container-wide">
    <p class="footer__copyright">© <span data-year>2026</span> {site.legalName}. All rights reserved.</p>
    <p class="footer__credit">
      <a href="https://austereautomations.com/website-development-belize" target="_blank" rel="noopener noreferrer">Developed by Austere Automations</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-navy);
    color: var(--text-invert);
    position: relative;
    margin-top: auto;
  }
  .divider-wave {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 60px;
    transform: translateY(-99%);
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(3.5rem, 6vw, 5.5rem) 3rem;
  }
  .footer__mission {
    margin-top: 1.2rem;
    max-width: 34ch;
    color: #ffffff;
    font-size: 0.95rem;
  }
  .footer__social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .social {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    transition: transform var(--dur), background var(--dur), color var(--dur), border-color var(--dur);
  }
  /* Brand colors for each network */
  .social--fb { color: #1877f2; }
  .social--ig { color: #e4405f; }
  .social--wa { color: #25d366; }
  .social--yt { color: #ff0000; }
  @media (hover: hover) and (pointer: fine) {
  .social:hover {
    transform: translateY(-3px);
    color: #fff;
    border-color: transparent;
  }
}
  @media (hover: hover) and (pointer: fine) {
  .social--fb:hover { background: #1877f2; }
}
  @media (hover: hover) and (pointer: fine) {
  .social--ig:hover { background: #e4405f; }
}
  @media (hover: hover) and (pointer: fine) {
  .social--wa:hover { background: #25d366; }
}
  @media (hover: hover) and (pointer: fine) {
  .social--yt:hover { background: #ff0000; }
}
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .footer__heading {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 1rem;
  }
  .footer__nav ul {
    display: grid;
    gap: 0.7rem;
  }
  .footer__nav a,
  .footer__contact span {
    color: #ffffff;
    font-size: 0.92rem;
    transition: color var(--dur);
  }
  @media (hover: hover) and (pointer: fine) {
  .footer__nav a:hover {
    color: #fff;
  }
}
  .footer__contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: #ffffff;
  }
  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: #ffffff;
  }
  .footer__copyright {
    color: #ffffff;
  }
  /* Developer credit: centered, Duke Marine gold, refined. */
  .footer__credit {
    width: 100%;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--gold);
  }
  .footer__credit a {
    color: var(--gold);
    text-decoration: none;
    transition: opacity var(--dur);
  }
  @media (hover: hover) and (pointer: fine) {
  .footer__credit a:hover {
    opacity: 0.82;
  }
}
  .footer__hours {
    display: grid;
    gap: 0.2rem;
  }
  .footer__hourline {
    display: block;
  }

  @media (max-width: 860px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer__nav {
      grid-template-columns: 1fr 1fr;
    }
    .footer__contact {
      grid-column: 1 / -1;
    }
  }
</style>
