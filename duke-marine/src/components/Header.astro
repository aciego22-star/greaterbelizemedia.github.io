---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, primaryCta, site } from '../data/site';

interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.split('#')[0]);

// Mobile quick-nav strip: Home + the top-level headings (always visible on mobile)
const stripItems = [{ label: 'Home', href: '/' }, ...nav.map((n) => ({ label: n.label, href: n.href }))];

// Real photo behind each mega-menu feature panel.
const featureImg: Record<string, string> = {
  Marine: '/media/life/boat-wake.jpg',
  Fishing: '/media/life/trolling-spread.jpg',
  Diving: '/media/life/reef-flats.jpg',
};
---

<a href="#main" class="skip-link">Skip to content</a>

<header class:list={['header', { 'is-solid': solid }]} data-header>
  <div class="header__bar container container-wide">
    <Logo />

    <nav class="nav" data-nav aria-label="Primary">
      <ul class="nav__list" role="list">
        {
          nav.map((item) =>
            item.children ? (
              <li class="nav__item" data-mega>
                <a
                  href={item.href}
                  class:list={['nav__link', 'nav__link--has-menu', { 'is-current': isActive(item.href) }]}
                >
                  {item.label}
                  <Icon name="chevron" size={16} class="nav__caret" />
                </a>
                <div class="mega" role="menu">
                  <div class="mega__inner">
                    <div class="mega__links">
                      {item.children.map((child) => (
                        <a href={child.href} class="mega__link" role="menuitem">
                          <span class="mega__label">{child.label}</span>
                          {child.desc && <span class="mega__desc">{child.desc}</span>}
                        </a>
                      ))}
                    </div>
                    <a
                      href={item.href}
                      class="mega__feature"
                      style={featureImg[item.label] ? `background-image: linear-gradient(180deg, rgba(7,22,40,.35), rgba(7,22,40,.86)), url(${featureImg[item.label]})` : undefined}
                    >
                      <span class="eyebrow">Browse all</span>
                      <span class="mega__feature-title">{item.label}</span>
                      <span class="link-arrow">
                        View catalog <Icon name="arrow" size={18} />
                      </span>
                    </a>
                  </div>
                </div>
              </li>
            ) : (
              <li class="nav__item">
                <a
                  href={item.href}
                  class:list={['nav__link', { 'is-current': isActive(item.href) }]}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <div class="nav__cta">
        <div class="nav__contact">
          <a href={`tel:${site.phoneHref}`} class="nav__phone">
            <Icon name="phone" size={17} />
            <span>{site.phoneDisplay}</span>
          </a>
          <a
            href={`https://wa.me/${site.whatsapp}`}
            class="nav__wa"
            target="_blank"
            rel="noopener"
            aria-label={`WhatsApp ${site.whatsappDisplay}`}
          >
            <Icon name="whatsapp" size={17} />
            <span>{site.whatsappDisplay}</span>
          </a>
        </div>
        <a href={primaryCta.href} class="btn btn--gold btn--sm">{primaryCta.label}</a>
      </div>
    </nav>

    <a href={primaryCta.href} class="btn btn--gold btn--sm hd-quote" aria-label={primaryCta.label}>Quote</a>
  </div>

  <nav class="hd-strip" aria-label="Sections">
    <div class="hd-strip__inner container container-wide">
      {
        stripItems.map((s) => (
          <a
            href={s.href}
            class:list={['hd-strip__link', { 'is-current': isActive(s.href) }]}
          >
            {s.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition: transform var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  .header.is-hidden {
    transform: translateY(-105%);
  }
  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
    color: #ffffff;
  }
  .header.is-scrolled,
  .header.is-solid {
    background: color-mix(in srgb, var(--c-navy) 88%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06), var(--shadow);
  }
  .header.is-scrolled .header__bar {
    height: 64px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-left: auto;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
  }
  .nav__item {
    position: relative;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.55rem 0.85rem;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    border-radius: var(--radius-pill);
    transition: color var(--dur-fast), background var(--dur-fast);
  }
  .nav__link:hover,
  .nav__link.is-current {
    background: rgba(255, 255, 255, 0.1);
  }
  .nav__caret {
    transition: transform var(--dur);
    opacity: 0.7;
  }

  /* Mega-menu */
  .mega {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translate(-50%, 10px);
    width: min(560px, 88vw);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur), transform var(--dur), visibility var(--dur);
    z-index: 20;
  }
  .mega::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 14px;
  }
  .nav__item[data-mega]:hover .mega,
  .nav__item[data-mega]:focus-within .mega,
  .nav__item[data-mega].is-open .mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
  .nav__item[data-mega]:hover .nav__caret {
    transform: rotate(180deg);
  }
  .mega__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 0.5rem;
    padding: 0.7rem;
    background: var(--c-paper);
    color: var(--c-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border);
  }
  .mega__links {
    display: grid;
    gap: 0.15rem;
  }
  .mega__link {
    display: grid;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius);
    transition: background var(--dur-fast);
  }
  .mega__link:hover {
    background: var(--bg-inset);
  }
  .mega__label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .mega__desc {
    font-size: 0.78rem;
    color: var(--text-soft);
  }
  .mega__feature {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 1.1rem;
    min-height: 150px;
    border-radius: var(--radius);
    background: var(--grad-deep);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--text-invert);
  }
  .mega__feature-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.1;
  }
  .mega__feature .link-arrow {
    color: var(--c-current-bright);
  }

  .nav__cta {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .nav__contact {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }
  .nav__phone,
  .nav__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    line-height: 1;
    color: #ffffff;
    white-space: nowrap;
    transition: opacity var(--dur-fast);
  }
  .nav__phone :global(svg),
  .nav__wa :global(svg) {
    display: block;
    flex: none;
    width: 15px;
    height: 15px;
  }
  .nav__wa :global(svg) {
    color: #25d366;
  }
  .nav__phone:hover,
  .nav__wa:hover {
    color: #fff;
    opacity: 0.85;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }
  .nav-toggle span {
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--dur), opacity var(--dur);
  }

  /* Mobile quick-nav strip (hidden on desktop) */
  .hd-quote {
    display: none;
  }
  .hd-strip {
    display: none;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .hd-strip__inner {
    display: flex;
    gap: 0.3rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    padding-block: 0.5rem;
    scroll-snap-type: x proximity;
  }
  .hd-strip__inner::-webkit-scrollbar {
    display: none;
  }
  .hd-strip__link {
    flex: none;
    scroll-snap-align: start;
    padding: 0.42rem 0.85rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: #ffffff;
    white-space: nowrap;
    transition: background var(--dur-fast), color var(--dur-fast);
  }
  .hd-strip__link.is-current {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
  }
  .hd-strip__link:not(.is-current):active {
    background: rgba(255, 255, 255, 0.14);
  }

  @media (max-width: 1180px) {
    .nav__list {
      gap: 0.1rem;
    }
    .nav__link {
      padding-inline: 0.65rem;
    }
    .nav__contact {
      display: none;
    }
  }

  @media (max-width: 980px) {
    /* Header is always solid navy on mobile so the strip stays legible */
    .header,
    .header.is-hidden {
      background: color-mix(in srgb, var(--c-navy) 94%, transparent);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06), var(--shadow);
      transform: none;
    }
    .nav {
      display: none;
    }
    .hd-quote {
      display: inline-flex;
    }
    .hd-strip {
      display: block;
    }
  }
</style>
