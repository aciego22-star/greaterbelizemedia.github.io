{
  "name": "universal-hardware-concept",
  "private": true,
  "version": "1.0.0",
  "description": "Independent website concept demonstration by Austere Automations. Not affiliated with Universal Hardware Company Ltd.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve.mjs dist 4322",
    "check": "astro check",
    "zip": "node scripts/make-zip.mjs",
    "test:logic": "rolldown tests/guide-cases.ts --platform node --format esm -o .cache/guide-cases.mjs && node .cache/guide-cases.mjs",
    "test:e2e": "node tests/run-qa.cjs",
    "test": "npm run test:logic && npm run test:e2e",
    "posters": "node scripts/render-poster.cjs",
    "screenshots": "node scripts/screenshots.cjs",
    "fonts": "bash scripts/build-fonts.sh",
    "preview:artifact": "node scripts/make-preview.mjs",
    "release": "npm run build && npm run zip && npm run preview:artifact"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.3.8",
    "preact": "10.29.8",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/three": "0.180.0",
    "axe-core": "4.10.3",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  }
}
