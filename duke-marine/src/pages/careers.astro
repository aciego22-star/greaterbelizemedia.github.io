---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { pageHeroes } from '../data/heroes';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const applyMailto = `mailto:${site.email}?subject=Employment%20Application`;
---

<BaseLayout
  title="Careers"
  description="Duke Marine is accepting applications for a Retail Sales Associate and a Marine Yard & Maintenance Assistant in Belize City. Email your CV to dukemarine@btl.net."
>
  <PageHero
    eyebrow="Careers"
    title="Join the Duke Marine Team"
    lead="Duke Marine is currently accepting applications for open positions in Belize City."
    crumbs={[{ label: 'Careers' }]}
    hero={pageHeroes.careers}
  />

  <!-- Open position -->
  <section class="section">
    <div class="container">
      <div class="jobs">
        <div class="job" data-reveal>
          <div>
            <h3>Retail Sales Associate</h3>
            <span class="job__type"><Icon name="pin" size={15} /> Belize City</span>
            <p>Help customers identify suitable marine, fishing and diving products, maintain an organized sales floor, support stock presentation and provide professional customer service.</p>
          </div>
          <a href="#apply" class="btn btn--ghost btn--sm">How to apply <Icon name="arrow" size={15} /></a>
        </div>
        <div class="job" data-reveal data-reveal-delay={80}>
          <div>
            <h3>Marine Yard &amp; Maintenance Assistant</h3>
            <span class="job__type"><Icon name="pin" size={15} /> Belize City</span>
            <p>Support the daily upkeep of the store, warehouse, and yard by maintaining a clean, organized, and safe environment. Assist with receiving and moving inventory, preparing customer orders, handling general maintenance tasks, and supporting the team with day-to-day operational activities to ensure the business runs efficiently.</p>
          </div>
          <a href="#apply" class="btn btn--ghost btn--sm">How to apply <Icon name="arrow" size={15} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Apply -->
  <section id="apply" class="section-tight" style="background: var(--bg-inset)">
    <div class="container">
      <div class="apply card" data-reveal>
        <span class="eyebrow">Apply</span>
        <h2>Apply to Join the Duke Marine Team</h2>
        <p class="apply__copy">
          Interested applicants may email their CV and a short introduction to
          <a href={`mailto:${site.email}`}>{site.email}</a>. Please note the
          position you are applying for in the email subject.
        </p>
        <div class="apply__actions">
          <a href={applyMailto} class="btn btn--gold"><Icon name="mail" size={18} /> Email Your Application</a>
          <a href="/contact" class="btn btn--ghost">Contact Duke Marine <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .jobs {
    display: grid;
    gap: 1rem;
  }
  .job {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 1.7rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur);
  }
  @media (hover: hover) and (pointer: fine) {
  .job:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
}
  .job h3 {
    font-size: 1.2rem;
  }
  .job__type {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-strong);
    margin: 0.3rem 0 0.5rem;
  }
  .job p {
    color: var(--text-soft);
    font-size: 0.92rem;
    max-width: 62ch;
  }
  .job .btn {
    flex: none;
  }

  .apply {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 2.2rem;
    text-align: center;
  }
  .apply h2 {
    margin: 0.6rem 0 1rem;
  }
  .apply__copy {
    color: var(--text-soft);
    max-width: 56ch;
    margin: 0 auto 1.6rem;
  }
  .apply__copy a {
    color: var(--accent-strong);
    font-weight: 600;
  }
  .apply__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
  }

  @media (max-width: 620px) {
    .job {
      flex-direction: column;
      align-items: flex-start;
    }
    .apply__actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
