---
import SitePhoto from './SitePhoto.astro';
import type { Department } from '../data/departments';
import { CATEGORY_BY_SLUG } from '../data/categories';
import { FEATURED_PHOTOS } from '../data/site-images';

interface Props {
  dept: Department;
  index: number;
}
const { dept, index } = Astro.props;
const primary = CATEGORY_BY_SLUG[dept.categories[0]];
const also = dept.categories.slice(1).map((s) => CATEGORY_BY_SLUG[s]);
const photo = FEATURED_PHOTOS[primary.slug];
---
<article class="dept" data-tilt data-reveal style={`--i:${index % 4}`}>
  <div class="dept__inner">
    <div class="dept__top">
      <span class="dept__num mono">{String(index + 1).padStart(2, '0')}</span>
    </div>
    <div class="dept__art photo-stage">
      <SitePhoto image={photo} decorative />
    </div>
    <div class="dept__body">
      <h3 class="dept__title">
        <a class="dept__link" href={`/products/${primary.slug}/`}>{dept.name}</a>
      </h3>
      <p class="dept__blurb">{dept.blurb}</p>
      <ul class="dept__tags">
        {dept.highlights.map((h) => <li>{h}</li>)}
      </ul>
      {
        also.length > 0 && (
          <p class="dept__also">
            Also see{' '}
            {also.map((c, i) => (
              <>
                {i > 0 && ', '}
                <a href={`/products/${c.slug}/`}>{c.name}</a>
              </>
            ))}
          </p>
        )
      }
    </div>
  </div>
</article>

<style>
  .dept {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    perspective: 900px;
  }
  .dept__inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 20px 22px 22px;
    border-radius: var(--radius-lg);
    background: var(--baby-blue);
    border: 1px solid rgba(85, 144, 201, 0.28);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition:
      transform 500ms var(--ease-out),
      box-shadow 500ms var(--ease-out),
      border-color var(--dur);
  }
  .dept:hover .dept__inner {
    box-shadow: var(--shadow-lg);
    border-color: var(--blue-200);
  }
  .dept__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .dept__num {
    color: var(--steel-400);
  }
  .dept__art {
    margin: 14px 0 16px;
    aspect-ratio: 5 / 4;
    padding: 14px;
  }
  .dept__art :global(img) {
    transition: transform 600ms var(--ease-out);
  }
  .dept:hover .dept__art :global(img) {
    transform: scale(1.05);
  }
  .dept__title {
    font-size: 1.28rem;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .dept__link {
    color: var(--ink);
    text-decoration: none;
  }
  .dept__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    z-index: 1;
  }
  .dept__link:focus-visible {
    outline: none;
  }
  .dept__link:focus-visible::after {
    outline: 2px solid var(--blue-600);
    outline-offset: 3px;
  }
  .dept__blurb {
    margin-top: 8px;
    color: var(--steel);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .dept__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
    list-style: none;
  }
  .dept__tags li {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--mist);
    border: 1px solid var(--line);
    font-size: 0.76rem;
    font-weight: 550;
    color: var(--ink);
  }
  .dept__also {
    position: relative;
    z-index: 2;
    margin-top: 12px;
    font-size: 0.82rem;
    color: var(--steel);
  }
  .dept__also a {
    display: inline-block;
    padding: 4px 0;
    font-weight: 600;
  }
  @media (max-width: 559px) {
    .dept__inner {
      padding: 14px 14px 16px;
      border-radius: 18px;
    }
    .dept__link::after {
      border-radius: 18px;
    }
    .dept__art {
      margin: 10px 0 10px;
      padding: 8px;
      border-radius: 12px;
    }
    .dept__title {
      font-size: 1.02rem;
    }
    .dept__blurb,
    .dept__tags {
      display: none;
    }
    .dept__also {
      font-size: 0.76rem;
      margin-top: 6px;
    }
  }
</style>
