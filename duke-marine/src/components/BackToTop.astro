---
import Icon from './Icon.astro';
---

<button class="to-top" data-to-top aria-label="Back to top" hidden>
  <Icon name="arrow-up" size={22} />
</button>

<style>
  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 90;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    background: var(--c-navy);
    color: #fff;
    box-shadow: var(--shadow-lg);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out),
      background var(--dur);
  }
  .to-top.is-visible {
    opacity: 1;
    transform: none;
  }
  .to-top:hover {
    background: var(--accent-strong);
  }
  .to-top:focus-visible {
    outline: 3px solid var(--c-current-bright);
    outline-offset: 3px;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-to-top]');
  if (btn) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    btn.hidden = false;
    const onScroll = () => btn.classList.toggle('is-visible', window.scrollY > 500);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    btn.addEventListener('click', () =>
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }),
    );
  }
</script>
