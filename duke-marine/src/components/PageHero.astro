---
import OceanCanvas from './OceanCanvas.astro';
import Icon from './Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  /** Real header photo in public/media. Falls back to the animated ocean canvas. */
  image?: string;
  imageAlt?: string;
  /** Focal point for the header photo, e.g. "center", "50% 35%". */
  imagePosition?: string;
}
const { eyebrow, title, lead, crumbs = [], image, imageAlt = '', imagePosition = 'center' } = Astro.props;
---

<section class="page-hero on-dark">
  {
    image ? (
      <div class="page-hero__bg" aria-hidden={imageAlt ? undefined : 'true'}>
        <img src={image} alt={imageAlt} loading="eager" style={`object-position:${imagePosition}`} />
        <span class="page-hero__scrim"></span>
      </div>
    ) : (
      <OceanCanvas />
    )
  }
  <div class="container page-hero__inner">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c) => (
            <>
              <Icon name="chevron" size={14} class="crumbs__sep" />
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )
    }
    {eyebrow && <span class="eyebrow" data-reveal>{eyebrow}</span>}
    <h1 class="page-hero__title" data-reveal data-reveal-delay="60">{title}</h1>
    {lead && <p class="lead page-hero__lead" data-reveal data-reveal-delay="120">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(3rem, 7vw, 6rem));
    padding-bottom: clamp(3rem, 7vw, 6rem);
    color: var(--text-invert);
    overflow: hidden;
    background: var(--c-navy);
  }
  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .page-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .page-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(7, 22, 40, 0.9) 0%,
      rgba(7, 22, 40, 0.78) 42%,
      rgba(7, 22, 40, 0.55) 100%
    );
  }
  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.4rem;
    font-size: 0.82rem;
    color: var(--text-soft);
  }
  .crumbs a:hover {
    color: var(--c-current-bright);
  }
  .crumbs__sep {
    transform: rotate(-90deg);
    opacity: 0.5;
  }
  .crumbs [aria-current] {
    color: var(--c-current-bright);
  }
  .page-hero__title {
    font-size: var(--fs-h1);
    margin-top: 0.9rem;
    max-width: 18ch;
  }
  .page-hero__lead {
    margin-top: 1.1rem;
    color: #cfe4e6;
    max-width: 60ch;
  }
</style>
