---
import OceanCanvas from './OceanCanvas.astro';
import Icon from './Icon.astro';

import type { PageHeroImage } from '../data/heroes';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  /**
   * Centralized header artwork from src/data/heroes.ts. Individual props below
   * still work and win over the config, so existing pages are unaffected.
   */
  hero?: PageHeroImage;
  /** Real header photo in public/media. Falls back to the animated ocean canvas. */
  image?: string;
  imageAlt?: string;
  /** Focal point for the header photo, e.g. "center", "50% 35%". */
  imagePosition?: string;
  /** Narrow crop served at 640px and below. */
  mobileImage?: string;
  /** Intrinsic size of the desktop source; supplied to reduce layout shift. */
  imageWidth?: number;
  imageHeight?: number;
  /**
   * Aspect ratio of the header artwork, e.g. 2.224. Supplying it makes the
   * header take the shape of the picture instead of forcing the picture into a
   * fixed box, so the whole frame is shown rather than a crop of it. The header
   * still grows if the wording needs more room than the shape allows.
   */
  aspect?: number;
  /** Same, for the narrow crop served below 640px. */
  aspectMobile?: number;
}
const {
  eyebrow,
  title,
  lead,
  crumbs = [],
  hero,
  image,
  imageAlt,
  imagePosition,
  mobileImage,
  imageWidth,
  imageHeight,
  aspect,
  aspectMobile,
} = Astro.props;

// Explicit props take precedence; otherwise fall back to the shared config.
const src = image ?? hero?.src;
const srcMobile = mobileImage ?? hero?.mobileSrc;
const alt = imageAlt ?? hero?.alt ?? '';
const position = imagePosition ?? hero?.position ?? 'center';
const w = imageWidth ?? hero?.width;
const h = imageHeight ?? hero?.height;

const ar = aspect ?? hero?.aspect;
const arMobile = aspectMobile ?? hero?.aspectMobile ?? ar;
const arStyle = ar ? `--hero-ar:${ar}; --hero-ar-m:${arMobile}` : undefined;
---

<section class:list={['page-hero', 'on-dark', { 'page-hero--whole': !!ar }]} style={arStyle}>
  {
    src ? (
      <div class="page-hero__bg" aria-hidden={alt ? undefined : 'true'}>
        <picture>
          {srcMobile && <source media="(max-width: 640px)" srcset={srcMobile} />}
          {/* Header art sits above the fold, so it is loaded with priority
              rather than lazily. Width/height reserve the box to avoid shift. */}
          <img
            src={src}
            alt={alt}
            width={w}
            height={h}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style={`object-position:${position}`}
          />
        </picture>
        <span class="page-hero__scrim"></span>
      </div>
    ) : (
      <OceanCanvas />
    )
  }
  <div class="container page-hero__inner">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c) => (
            <>
              <Icon name="chevron" size={14} class="crumbs__sep" />
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )
    }
    {eyebrow && <span class="eyebrow" data-reveal>{eyebrow}</span>}
    <h1 class="page-hero__title" data-reveal data-reveal-delay="60">{title}</h1>
    {lead && <p class="lead page-hero__lead" data-reveal data-reveal-delay="120">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  /* Takes the shape of the picture so the whole frame shows rather than a
     crop. aspect-ratio yields to the content, so the header still grows if the
     wording needs more height than the picture's shape gives it. */
  /* min-height rather than aspect-ratio: the header clips its overflow, so a
     fixed aspect would hold a box shorter than the wording needs and push the
     text out over the section below. A minimum lets the shape be honoured
     wherever there is room and simply gives way where there is not. */
  .page-hero--whole {
    min-height: calc(100vw / var(--hero-ar));
  }
  @media (max-width: 640px) {
    .page-hero--whole {
      min-height: calc(100vw / var(--hero-ar-m, var(--hero-ar)));
    }
  }
  .page-hero {
    position: relative;
    padding-top: calc(var(--header-offset) + clamp(3rem, 7vw, 6rem));
    padding-bottom: clamp(3rem, 7vw, 6rem);
    color: var(--text-invert);
    overflow: hidden;
    /* Intentional Duke Marine marine-gradient fallback. It sits beneath the
       animated ocean canvas, so a header still reads as finished if the
       animation is unavailable, blocked or reduced by user preference. */
    background: var(--c-navy);
    background-image:
      radial-gradient(90% 120% at 12% 0%, rgba(24, 179, 199, 0.28) 0%, rgba(12, 35, 64, 0) 60%),
      radial-gradient(70% 100% at 100% 100%, rgba(18, 48, 86, 0.9) 0%, rgba(12, 35, 64, 0) 70%),
      linear-gradient(160deg, #0c2340 0%, #123056 52%, #0a1c33 100%);
  }
  .page-hero__bg picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .page-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .page-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(7, 22, 40, 0.9) 0%,
      rgba(7, 22, 40, 0.78) 42%,
      rgba(7, 22, 40, 0.55) 100%
    );
  }
  .page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.4rem;
    font-size: 0.82rem;
    color: var(--text-soft);
  }
  @media (hover: hover) and (pointer: fine) {
  .crumbs a:hover {
    color: var(--c-current-bright);
  }
}
  .crumbs__sep {
    transform: rotate(-90deg);
    opacity: 0.5;
  }
  .crumbs [aria-current] {
    color: var(--c-current-bright);
  }
  .page-hero__title {
    font-size: var(--fs-h1);
    margin-top: 0.9rem;
    max-width: 18ch;
  }
  .page-hero__lead {
    margin-top: 1.1rem;
    color: #cfe4e6;
    max-width: 60ch;
  }
</style>
