---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../data/site';

interface ArticleMeta {
  publishedTime: string;
  author: string;
  section?: string;
  headline: string;
  imageUrl?: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Describes the share image. Defaults to a description of the brand card. */
  imageAlt?: string;
  noindex?: boolean;
  solidHeader?: boolean;
  /** "website" for normal pages, "article" for blog posts. */
  ogType?: string;
  /** Supplied by blog posts to emit BlogPosting structured data. */
  article?: ArticleMeta;
  /**
   * Images to fetch as early as possible. Only worth using for artwork the
   * browser cannot find on its own: a plain <img> is spotted by the preload
   * scanner already, but a CSS background is not discovered until the
   * stylesheets have loaded and the page has been laid out. `media` narrows a
   * preload to the screens that will actually display it, so a phone never
   * downloads the desktop file or the other way round.
   */
  preloadImages?: { href: string; media?: string }[];
}

const {
  title,
  description = site.description,
  image = '/social-card.jpg',
  imageAlt,
  noindex = false,
  solidHeader = false,
  ogType = 'website',
  article,
  preloadImages = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const socialImage = new URL(image, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: site.phoneDisplay,
  email: site.email,
  image: socialImage,
  logo: new URL('/favicon-512.png', site.url).href,
  foundingDate: '1991',
  founder: [
    { '@type': 'Person', name: 'Paul Duke' },
    { '@type': 'Person', name: 'Ruth Duke' },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.address.lat,
    longitude: site.address.lng,
  },
  openingHoursSpecification: site.hours
    .filter((h) => h.time !== 'Closed')
    .map((h) => ({ '@type': 'OpeningHoursSpecification', description: `${h.day} ${h.time}` })),
};

// Blog posts additionally describe themselves as a BlogPosting.
const articleLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: article.headline,
      description,
      image: article.imageUrl ? new URL(article.imageUrl, site.url).href : socialImage,
      datePublished: article.publishedTime,
      dateModified: article.publishedTime,
      author: { '@type': 'Organization', name: article.author, url: site.url },
      publisher: {
        '@type': 'Organization',
        name: site.name,
        logo: { '@type': 'ImageObject', url: new URL('/favicon-512.png', site.url).href },
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      ...(article.section ? { articleSection: article.section } : {}),
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    {
      preloadImages.map((p) => (
        <link rel="preload" as="image" href={p.href} media={p.media} fetchpriority="high" />
      ))
    }

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#071f30" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content={imageAlt ?? `${site.name}, marine parts, sales and service in Belize City`}
    />
    {socialImage.endsWith('/social-card.jpg') && (
      <>
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && <meta property="article:author" content={article.author} />}
    {article && article.section && <meta property="article:section" content={article.section} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
  </head>
  <body>
    <Header solid={solidHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    flex: 1;
  }
  body.nav-open {
    overflow: hidden;
  }
</style>
