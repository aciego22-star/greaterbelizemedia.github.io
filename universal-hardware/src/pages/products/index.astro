---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CatalogueSearch from '../../islands/CatalogueSearch.tsx';
---
<Base
  title="Products"
  description="Search Universal Hardware's twelve product categories: power tools, welding, generators, water pumps, lawn and garden, motorcycles, household and more."
  section="products"
>
  <PageHero
    eyebrow="Product categories"
    title="Find tools and equipment for the job."
    lead="Search across categories, product types and brands, then ask the Product Guide or a branch about anything you need."
    crumbs={[{ label: 'Products' }]}
  />
  <section class="section section--tight">
    <div class="container">
      <CatalogueSearch client:load />
      <div class="products-foot">
        <div class="products-foot__cta">
          <p><strong>Not sure where to start?</strong> Answer three quick questions.</p>
          <a class="btn btn--ghost" href="/find/">Find the Right Product <Icon name="arrow-right" size={18} class="btn-arrow" /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .products-foot {
    margin-top: 48px;
  }
  .products-foot__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 20px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
</style>
