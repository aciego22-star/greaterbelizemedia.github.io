{
  "name": "cojacs-sumptuous-rumpopo",
  "private": true,
  "version": "1.0.0",
  "description": "Cojac's Sumptuous Rumpopo \u2014 seasonal brand website, flavour catalogue and WhatsApp order requests.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-routes.mjs",
    "build:preview": "VITE_SHOW_LAUNCH_NOTES=true npm run build",
    "build:illustrative": "VITE_SHOW_LAUNCH_NOTES=true VITE_ILLUSTRATIVE_MENU=true npm run build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "qa:screens": "node scripts/qa-screenshots.mjs",
    "qa:flow": "node scripts/qa-order-flow.mjs",
    "build:artifact": "VITE_ARTIFACT=true VITE_SHOW_LAUNCH_NOTES=true BASE_PATH=./ sh -c 'tsc -b && vite build --outDir dist-artifact'"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
