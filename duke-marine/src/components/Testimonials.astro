---
import Icon from './Icon.astro';
import { testimonials } from '../data/testimonials';
---

<div class="tgrid">
  {
    testimonials.map((t, i) => (
      <figure class="tcard" data-reveal data-reveal-delay={i * 100}>
        <span class="tcard__mark" aria-hidden="true"><Icon name="quote" size={26} /></span>
        <div class="tcard__stars" aria-label="5 out of 5 stars">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={16} />)}
        </div>
        <blockquote class="tcard__quote">{t.quote}</blockquote>
        <figcaption class="tcard__cite">
          <strong>{t.name}</strong>
          <span>{t.role}</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .tgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }
  .tcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 1.7rem 1.7rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .tcard__mark {
    color: var(--accent);
    opacity: 0.35;
  }
  .tcard__stars {
    display: flex;
    gap: 0.15rem;
    color: var(--gold);
    fill: var(--gold);
  }
  .tcard__stars :global(svg) {
    fill: var(--gold);
  }
  .tcard__quote {
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--text);
    flex: 1;
  }
  .tcard__cite {
    display: flex;
    flex-direction: column;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .tcard__cite strong {
    font-family: var(--font-display);
  }
  .tcard__cite span {
    font-size: 0.85rem;
    color: var(--text-soft);
  }
</style>
