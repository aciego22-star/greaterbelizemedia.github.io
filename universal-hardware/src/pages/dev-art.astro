---
import Base from '../layouts/Base.astro';
import CategoryArt from '../components/CategoryArt.astro';
const ids = ['drill','welding','handtools','mower','fan','saw','generator','pump','fridge','fence','compressor','motorcycle'] as const;
---
<Base title="art" description="art">
  <div class="container" style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;padding:24px">
    {ids.map((id) => <div style="border:1px solid #dde8f0;border-radius:12px;padding:12px;background:#f3f7fb"><p class="mono">{id}</p><CategoryArt id={id} /></div>)}
  </div>
</Base>
