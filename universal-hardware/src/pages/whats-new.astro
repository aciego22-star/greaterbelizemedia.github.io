---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SitePhoto from '../components/SitePhoto.astro';
import Icon from '../components/Icon.astro';
import { NEWS, YEARLY } from '../data/whats-new';

const [latest, ...earlier] = NEWS;
const year = (iso: string) => iso.slice(0, 4);
---
<Base
  title="What's New at Universal"
  description="Sales, events and Makita Clinics at Universal Hardware's Spanish Lookout and Belize City branches: the Mega Sale, the Friends & Family Sale, the Spanish Lookout Expo and more."
  section="whats-new"
>
  <PageHero
    eyebrow="News & events"
    title="What's New at Universal"
    lead="Sales, events and clinics at the Spanish Lookout and Belize City branches, newest first."
    crumbs={[{ label: "What's New" }]}
  />

  <section class="section section--tight" aria-labelledby="latest-title">
    <div class="container">
      <p class="eyebrow">Latest</p>
      <article class="news-feature" id={latest.id} data-reveal>
        <div class="news-feature__flyer">
          <SitePhoto image={latest.image} class="news-flyer" eager />
        </div>
        <div class="news-feature__body">
          <p class="news-kind mono"><Icon name="tag" size={14} /> {latest.kind}</p>
          <h2 class="h2" id="latest-title">{latest.title}</h2>
          <ul class="news-meta">
            <li><Icon name="calendar" size={18} /><time datetime={latest.start}>{latest.when}</time></li>
            <li><Icon name="map-pin" size={18} /><span>{latest.where}</span></li>
          </ul>
          <p class="news-summary">{latest.summary}</p>
          <ul class="news-details">
            {latest.details.map((d) => <li><Icon name="check" size={16} /><span>{d}</span></li>)}
          </ul>
          <p class="news-brands"><span class="mono muted">Featured brands</span> {latest.brands.map((b) => <span class="news-brand">{b}</span>)}</p>
        </div>
        {
          latest.extra && (
            <div class="news-extra">
              <SitePhoto image={latest.extra.image} class="news-extra__flyer" />
              <div>
                <p class="news-kind mono"><Icon name="wrench" size={14} /> Clinic</p>
                <h3 class="h3">{latest.extra.title}</h3>
                <p>{latest.extra.summary}</p>
                <p class="muted">Held during the {latest.title}, {latest.when}.</p>
              </div>
            </div>
          )
        }
      </article>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="earlier-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Earlier</p>
        <h2 class="h2" id="earlier-title">Recent sales and events</h2>
      </div>
      <ol class="news-list">
        {
          earlier.map((n) => (
            <li class:list={['news-card', { 'news-card--wide': n.image.width > n.image.height * 1.4 }]} id={n.id} data-reveal>
              <div class="news-card__flyer">
                <SitePhoto image={n.image} class="news-flyer" />
              </div>
              <div class="news-card__body">
                <p class="news-kind mono">
                  <Icon name={n.kind === 'Event' ? 'store' : 'tag'} size={14} /> {n.kind} · {year(n.start)}
                </p>
                <h3 class="h3">{n.title}</h3>
                <ul class="news-meta">
                  <li><Icon name="calendar" size={18} /><time datetime={n.start}>{n.when}</time></li>
                  <li><Icon name="map-pin" size={18} /><span>{n.where}</span></li>
                </ul>
                <p class="news-summary">{n.summary}</p>
                <ul class="news-details">
                  {n.details.map((d) => <li><Icon name="check" size={16} /><span>{d}</span></li>)}
                </ul>
                {n.extra && (
                  <div class="news-card__extra">
                    <SitePhoto image={n.extra.image} class="news-card__extra-flyer" />
                    <p><strong>{n.extra.title}.</strong> {n.extra.summary}</p>
                  </div>
                )}
                <p class="news-brands"><span class="mono muted">Featured brands</span> {n.brands.map((b) => <span class="news-brand">{b}</span>)}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="yearly-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Every year</p>
        <h2 class="h2" id="yearly-title">Dates to watch for</h2>
        <p class="lead">Universal's two big sales come round every year. Dates are announced here and at the branches.</p>
      </div>
      <div class="yearly">
        {
          YEARLY.map((y) => (
            <div class="yearly__card" data-reveal>
              <Icon name="calendar" size={28} />
              <h3 class="h3">{y.title}</h3>
              <p class="yearly__when">{y.when} · {y.where}</p>
              <p class="muted">{y.note}</p>
            </div>
          ))
        }
        <div class="yearly__card yearly__card--cta" data-reveal>
          <Icon name="sparkle" size={28} />
          <h3 class="h3">Questions about a sale?</h3>
          <p>Ask Universal AI, or message the branch on WhatsApp.</p>
          <div class="yearly__actions">
            <button type="button" class="btn btn--light" data-open-guide data-guide-prompt="Is there a sale coming up?">
              <Icon name="sparkle" size={18} /> Ask Universal AI
            </button>
            <a class="btn btn--ghost-dark" href="/locations/">Branches &amp; WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .news-feature {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
    margin-top: 16px;
    padding: clamp(16px, 2.5vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: 0 18px 50px rgba(13, 28, 44, 0.07);
  }
  @media (min-width: 1000px) {
    .news-feature {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .news-feature__flyer :global(.news-flyer),
  .news-card__flyer :global(.news-flyer) {
    display: block;
  }
  :global(.news-flyer img),
  :global(.news-extra__flyer img),
  :global(.news-card__extra-flyer img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #fff;
  }
  .news-kind {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .news-meta {
    display: grid;
    gap: 8px;
    margin: 14px 0;
    list-style: none;
    font-weight: 550;
  }
  .news-meta li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .news-meta :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--blue-600);
  }
  .news-summary {
    font-size: 1.05rem;
  }
  .news-details {
    display: grid;
    gap: 6px;
    margin: 12px 0 0;
    list-style: none;
    color: var(--ink-2, inherit);
  }
  .news-details li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .news-details :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--blue-600);
  }
  .news-brands {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-top: 16px;
  }
  .news-brands .mono {
    margin-right: 4px;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .news-brand {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.85rem;
    background: var(--paper);
  }
  .news-extra {
    display: grid;
    gap: 20px;
    align-items: center;
    padding-top: clamp(16px, 2.5vw, 28px);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .news-extra {
      grid-template-columns: 220px 1fr;
    }
  }
  @media (min-width: 1000px) {
    .news-extra {
      grid-column: 1 / -1;
    }
  }
  .news-extra .h3 {
    margin-bottom: 6px;
  }
  .news-extra p + p {
    margin-top: 6px;
  }

  .news-list {
    display: grid;
    gap: 20px;
    margin-top: 24px;
    list-style: none;
  }
  .news-card {
    display: grid;
    gap: 20px;
    padding: clamp(16px, 2.5vw, 24px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }
  @media (min-width: 800px) {
    .news-card {
      grid-template-columns: 300px minmax(0, 1fr);
      align-items: start;
    }
  }
  @media (min-width: 1100px) {
    .news-card {
      grid-template-columns: 360px minmax(0, 1fr);
    }
  }
  .news-card__flyer {
    max-width: 420px;
  }
  /* Wide banner flyers run across the card, with the details below. */
  .news-card.news-card--wide {
    grid-template-columns: minmax(0, 1fr);
  }
  .news-card--wide .news-card__flyer {
    max-width: 820px;
  }
  .news-card__body .h3 {
    margin-bottom: 2px;
  }
  .news-card__extra {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 14px;
    align-items: center;
    margin-top: 16px;
    padding: 12px;
    border-radius: var(--radius);
    background: var(--mist);
  }

  .yearly {
    display: grid;
    gap: 20px;
    margin-top: 24px;
  }
  @media (min-width: 900px) {
    .yearly {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .yearly__card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }
  .yearly__card > :global(svg) {
    color: var(--blue-600);
  }
  .yearly__when {
    font-weight: 600;
    color: var(--blue-700);
  }
  .yearly__card--cta {
    background: var(--graphite);
    border-color: var(--graphite);
    color: var(--on-dark);
  }
  .yearly__card--cta .h3 {
    color: #fff;
  }
  .yearly__card--cta > :global(svg) {
    color: #7cc0f5;
  }
  .yearly__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
</style>
