# Copy to .env and fill in. Never commit real credentials.
# Start with: npm run start:env   (or export these in your host's environment settings)

# --- confident AI (Claude API) ---
# Without a key the site works, and confident AI shows the phone / Instagram fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high. "low" keeps chat replies quick and inexpensive.
ANTHROPIC_EFFORT=low
# Server-side refusal fallback ("default"), or "off" to disable.
ANTHROPIC_FALLBACKS=default
# Without a key, preview sites use the scripted demo assistant. Force with on|off.
ASSISTANT_DEMO=

# --- Server ---
PORT=3000
# If set, /preview/test-calendar requires ?token=<value>
PREVIEW_TOKEN=

# Optional: secret for signing booking references (16+ characters). If unset, one is generated
# once and stored with the site data.
SESSION_SECRET=

# --- Scheduling ---
# Simulate provider problems for demos: unavailable | timeout | timeout-after-write
CALENDAR_FAULT=
# Only when scheduling.json -> "adapter": "google"
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
