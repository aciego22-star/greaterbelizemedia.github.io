---
/**
 * Animated ocean background — a lightweight, dependency-free canvas effect
 * (flowing wave bands + drifting light particles) used behind hero sections.
 * This is the modern "flash" motion the client asked for. It pauses when
 * off-screen and disables under prefers-reduced-motion.
 *
 * To use a real background VIDEO instead, pass `videoSrc` (mp4) and optional
 * `videoWebm` / `poster`; the canvas becomes a graceful fallback.
 */
interface Props {
  videoSrc?: string;
  videoWebm?: string;
  poster?: string;
  class?: string;
}
const { videoSrc, videoWebm, poster, class: cls = '' } = Astro.props;
---

<div class:list={['ocean', cls]} data-ocean>
  {
    videoSrc && (
      <video
        class="ocean__video"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster={poster}
      >
        {videoWebm && <source src={videoWebm} type="video/webm" />}
        <source src={videoSrc} type="video/mp4" />
      </video>
    )
  }
  <canvas class="ocean__canvas" data-ocean-canvas aria-hidden="true"></canvas>
  <div class="ocean__veil"></div>
</div>

<style>
  .ocean {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--grad-deep);
    z-index: -2;
  }
  .ocean__video,
  .ocean__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ocean__video {
    z-index: 1;
  }
  .ocean__canvas {
    z-index: 0;
  }
  .ocean__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      radial-gradient(120% 90% at 20% 0%, transparent 30%, rgba(5, 15, 24, 0.55) 100%),
      linear-gradient(180deg, rgba(5, 15, 24, 0.35) 0%, rgba(5, 15, 24, 0.15) 40%, rgba(5, 15, 24, 0.75) 100%);
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document
    .querySelectorAll<HTMLCanvasElement>('[data-ocean-canvas]')
    .forEach((canvas) => {
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const host = canvas.closest('[data-ocean]') as HTMLElement;

      let w = 0;
      let h = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      let raf = 0;
      let running = false;
      let t = 0;

      type P = { x: number; y: number; r: number; s: number; o: number };
      let particles: P[] = [];

      const bands = [
        { amp: 26, len: 0.008, sp: 0.012, y: 0.62, col: 'rgba(22,182,176,0.16)' },
        { amp: 34, len: 0.006, sp: 0.008, y: 0.72, col: 'rgba(18,84,122,0.28)' },
        { amp: 44, len: 0.004, sp: 0.006, y: 0.84, col: 'rgba(12,51,80,0.5)' },
        { amp: 60, len: 0.003, sp: 0.004, y: 0.95, col: 'rgba(5,15,24,0.7)' },
      ];

      function resize() {
        const rect = host.getBoundingClientRect();
        w = rect.width;
        h = rect.height;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = Math.round((w * h) / 26000);
        particles = Array.from({ length: Math.min(count, 70) }, () => ({
          x: Math.random() * w,
          y: Math.random() * h,
          r: Math.random() * 1.8 + 0.4,
          s: Math.random() * 0.25 + 0.05,
          o: Math.random() * 0.4 + 0.1,
        }));
      }

      function draw() {
        ctx.clearRect(0, 0, w, h);

        // drifting light particles (plankton / spray)
        for (const p of particles) {
          p.y -= p.s;
          p.x += Math.sin((t + p.y) * 0.01) * 0.15;
          if (p.y < -5) {
            p.y = h + 5;
            p.x = Math.random() * w;
          }
          ctx.beginPath();
          ctx.fillStyle = `rgba(120,220,214,${p.o})`;
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        }

        // layered wave bands
        for (const b of bands) {
          ctx.beginPath();
          ctx.moveTo(0, h);
          for (let x = 0; x <= w; x += 8) {
            const y =
              h * b.y +
              Math.sin(x * b.len + t * b.sp) * b.amp +
              Math.sin(x * b.len * 2.3 + t * b.sp * 1.7) * (b.amp * 0.35);
            ctx.lineTo(x, y);
          }
          ctx.lineTo(w, h);
          ctx.closePath();
          ctx.fillStyle = b.col;
          ctx.fill();
        }

        t += 1;
        raf = requestAnimationFrame(draw);
      }

      function start() {
        if (running || reduce) return;
        running = true;
        draw();
      }
      function stop() {
        running = false;
        cancelAnimationFrame(raf);
      }

      resize();
      window.addEventListener('resize', resize, { passive: true });

      if (reduce) {
        // paint a single static frame
        draw();
        stop();
      } else if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
          { threshold: 0.01 },
        );
        io.observe(host);
      } else {
        start();
      }
    });
</script>
