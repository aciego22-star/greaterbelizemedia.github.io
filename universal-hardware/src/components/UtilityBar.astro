---
import Icon from './Icon.astro';
---
<div class="utility on-dark" role="region" aria-label="Concept notice and locations">
  <div class="container utility__inner">
    <p class="utility__places">
      <Icon name="map-pin" size={14} />
      <span>Spanish Lookout</span>
      <span class="utility__sep" aria-hidden="true">•</span>
      <span>Belize City</span>
    </p>
    <p class="utility__concept">
      <a class="utility__badge" href="/concept/">
        <span class="tag-dot" aria-hidden="true"></span>
        Concept Preview
      </a>
      <span class="utility__note">Independent demo · not the official website</span>
    </p>
  </div>
</div>
