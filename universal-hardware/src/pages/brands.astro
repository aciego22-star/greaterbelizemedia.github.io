---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { BRANDS } from '../data/brands';
import { CATEGORY_BY_SLUG, CATEGORIES } from '../data/categories';
import { SOURCES, SOURCE_VIEWED } from '../data/sources';

const onPage = BRANDS.filter((b) => b.onBrandsPage);
const elsewhere = BRANDS.filter((b) => !b.onBrandsPage);
const usedCats = CATEGORIES.filter((c) => BRANDS.some((b) => b.categories.some((l) => l.slug === c.slug)));
---
<Base
  title="Brands"
  description="Brand names that appear on Universal Hardware's public website, with the exact page and category each mention comes from."
  section="brands"
>
  <PageHero
    eyebrow="Brand ecosystem"
    title="Brands on the current website."
    lead="Every brand Universal Hardware's website names, shown with exactly where it's mentioned. Brand names are set as text for identification only; logos and relationships would be confirmed with the company."
    crumbs={[{ label: 'Brands' }]}
  >
    <p class="notice brands-notice">
      <Icon name="info" />
      <span>A mention on the website doesn't confirm current stock, a current distribution agreement or exclusivity. Ask the branch about any specific line.</span>
    </p>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <div class="brand-filter" role="group" aria-label="Filter brands by category" data-brand-filter>
        <button type="button" class="chip" aria-pressed="true" data-filter="">All brands <span class="chip-count">{BRANDS.length}</span></button>
        {
          usedCats.map((c) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={c.slug}>
              {c.shortName}
            </button>
          ))
        }
      </div>
      <p class="brand-filter__status" aria-live="polite" data-brand-status>Showing all {BRANDS.length} brands.</p>

      <h2 class="h3 brand-group__title">On the Brands page <span class="muted">· {onPage.length}</span></h2>
      <ul class="brand-grid" data-brand-list>
        {
          onPage.map((b) => (
            <li class="brand-card" id={b.id} data-cats={b.categories.map((l) => l.slug).join(' ')}>
              <h3 class="brand-card__name">{b.name}</h3>
              {b.alsoWritten && <p class="brand-card__aka">Also written: {b.alsoWritten.join(', ')}</p>}
              <p class="brand-card__focus">{b.focus}</p>
              <p class="brand-card__rel"><Icon name="check" size={16} /> {b.relationship}</p>
              {b.categories.length > 0 && (
                <ul class="brand-card__cats">
                  {b.categories.map((l) => (
                    <li>
                      <a href={`/products/${l.slug}/`}>{CATEGORY_BY_SLUG[l.slug].name}</a>
                      <span class="brand-card__basis">{l.basis === 'listing' ? 'listed' : 'by description'}</span>
                    </li>
                  ))}
                </ul>
              )}
              <p class="brand-card__src">
                Source: {b.sources.map((s, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={SOURCES[s].url} target="_blank" rel="noopener">{SOURCES[s].title}</a>
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ul>

      <h2 class="h3 brand-group__title">Named elsewhere on the website <span class="muted">· {elsewhere.length}</span></h2>
      <ul class="brand-grid brand-grid--compact" data-brand-list>
        {
          elsewhere.map((b) => (
            <li class="brand-card" id={b.id} data-cats={b.categories.map((l) => l.slug).join(' ')}>
              <h3 class="brand-card__name">{b.name}</h3>
              <p class="brand-card__rel"><Icon name="check" size={16} /> {b.relationship}</p>
              <ul class="brand-card__cats">
                {b.categories.map((l) => (
                  <li><a href={`/products/${l.slug}/`}>{CATEGORY_BY_SLUG[l.slug].name}</a></li>
                ))}
              </ul>
              <p class="brand-card__src">
                Source: {b.sources.map((s, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={SOURCES[s].url} target="_blank" rel="noopener">{SOURCES[s].title}</a>
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="brand-empty" data-brand-empty hidden>No brands are linked to that category on the website.</p>

      <div class="brand-key">
        <h2 class="h3">How to read this page</h2>
        <dl>
          <div><dt><span class="brand-card__basis">listed</span></dt><dd>The Product Listing, Meilun &amp; Lifan or Hisun page names the brand within that category.</dd></div>
          <div><dt><span class="brand-card__basis">by description</span></dt><dd>Linked using how the Brands page itself describes the brand (for example "fencing products" for Bekaert).</dd></div>
        </dl>
        <p class="hint">All sources viewed {SOURCE_VIEWED}. Brand names and trademarks belong to their respective owners.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-brand-filter]');
  const status = document.querySelector<HTMLElement>('[data-brand-status]');
  const empty = document.querySelector<HTMLElement>('[data-brand-empty]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.brand-card'));
  const titles = Array.from(document.querySelectorAll<HTMLElement>('.brand-group__title'));
  const lists = Array.from(document.querySelectorAll<HTMLElement>('[data-brand-list]'));
  root?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const f = btn.dataset.filter || '';
    root.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    let shown = 0;
    cards.forEach((c) => {
      const on = !f || (c.dataset.cats || '').split(' ').includes(f);
      c.hidden = !on;
      if (on) shown++;
    });
    lists.forEach((l, i) => {
      const any = Array.from(l.children).some((c) => !(c as HTMLElement).hidden);
      l.hidden = !any;
      titles[i].hidden = !any;
    });
    if (empty) empty.hidden = shown > 0;
    if (status) status.textContent = f ? `Showing ${shown} ${shown === 1 ? 'brand' : 'brands'} linked to ${btn.textContent?.trim()}.` : `Showing all ${shown} brands.`;
  });
</script>

<style>
  .brands-notice {
    max-width: 720px;
  }
  .brand-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 640px) {
    .brand-filter {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 4px;
      scrollbar-width: none;
    }
    .brand-filter .chip {
      flex: none;
    }
  }
  .brand-filter__status {
    margin-top: 14px;
    font-size: 0.88rem;
    color: var(--steel);
  }
  .brand-group__title {
    margin: 40px 0 16px;
  }
  .brand-group__title[hidden] {
    display: none;
  }
  .brand-grid {
    list-style: none;
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
  }
  .brand-grid[hidden] {
    display: none;
  }
  @media (min-width: 640px) {
    .brand-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .brand-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .brand-grid--compact {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .brand-card {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 22px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--paper);
    scroll-margin-top: calc(var(--header-h) + 24px);
    transition: border-color var(--dur), box-shadow 400ms var(--ease-out);
  }
  .brand-card:target {
    border-color: var(--blue-600);
    box-shadow: 0 0 0 1px var(--blue-600), var(--shadow);
  }
  .brand-card[hidden] {
    display: none;
  }
  .brand-card__name {
    font-size: 1.55rem;
    font-stretch: 112%;
    letter-spacing: -0.02em;
  }
  .brand-card__aka {
    font-size: 0.78rem;
    color: var(--steel);
    margin-top: -4px;
  }
  .brand-card__focus {
    color: var(--steel);
    font-size: 0.92rem;
  }
  .brand-card__rel {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 550;
  }
  .brand-card__rel :global(svg) {
    color: var(--blue-600);
    margin-top: 2px;
  }
  .brand-card__cats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .brand-card__cats li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px 4px 10px;
    border-radius: 999px;
    background: var(--mist);
    border: 1px solid var(--line);
    font-size: 0.8rem;
  }
  .brand-card__cats a {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    min-height: 28px;
    display: inline-flex;
    align-items: center;
  }
  .brand-card__cats a:hover {
    color: var(--blue-700);
    text-decoration: underline;
  }
  .brand-card__basis {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 999px;
    background: var(--paper);
    color: var(--steel);
    border: 1px solid var(--line);
  }
  .brand-card__src {
    font-size: 0.76rem;
    color: var(--steel);
  }
  .brand-empty {
    margin-top: 24px;
    color: var(--steel);
  }
  .brand-key {
    margin-top: 56px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--mist);
    display: grid;
    gap: 14px;
  }
  .brand-key dl {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .brand-key dl div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 12px;
    align-items: start;
  }
  .brand-key dd {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
